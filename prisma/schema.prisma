// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  googleId      String?        @unique
  orbitId       String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  preferences   String?
  saves         SavedContent[]
  followedTags  FollowedTag[]
  notifications Notification[]
}

model SavedContent {
  id            String   @id @default(uuid())
  postId        String   // ID post from danbooru
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl      String?
  fileUrl       String?
  extension     String?
  rating        String?
  score         Int?
  size          Int?
  uploadedAt    DateTime?
  source        String?
  tags          String?

  savedAt       DateTime @default(now())

  @@unique([userId, postId])
}

model FollowedTag {
  id          String   @id @default(uuid())
  tagName     String
  tagType     Int      
  lastPostId  Int?     
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, tagName])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  link        String?  
  isRead      Boolean  @default(false)
  imageUrl    String?
  extension   String?
  rating      String?
  createdAt   DateTime @default(now())
}
