<%- include('partials/header') %>

<main class="container mx-auto p-4 max-w-4xl min-h-screen">
  <h1 class="text-3xl font-bold text-white mb-6">Daftar Notifikasi</h1>

  <% if (notifications && notifications.length > 0) { 
      // Group notifications by date string
      const grouped = {};
      notifications.forEach(n => {
         const date = new Date(n.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
         if (!grouped[date]) grouped[date] = [];
         grouped[date].push(n);
      });
  %>
    
    <% for (const [date, notifs] of Object.entries(grouped)) { %>
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-300 border-b border-gray-700 pb-2 mb-4"><%= date %></h2>
        <div class="space-y-3">
          <% notifs.forEach(n => { %>
            <a href="<%= n.link %>" class="flex p-4 bg-gray-800 border border-gray-700 rounded-lg hover:bg-gray-700 transition-colors shadow-sm">
              <% if (n.imageUrl) { %>
                <img src="<%= n.imageUrl %>" class="w-20 h-20 object-cover rounded-md mr-4 flex-shrink-0" alt="Thumbnail">
              <% } %>
              <div class="flex-grow flex flex-col justify-center">
                <div class="font-semibold text-white text-lg mb-1"><%= n.title %></div>
                <div class="text-sm text-gray-300 mb-2"><%= n.message %></div>
                <div class="flex items-center gap-2">
                  <% if (n.extension) { %>
                    <span class="bg-blue-600 text-white text-[10px] font-bold px-2 py-0.5 rounded"><%= n.extension.toUpperCase() %></span>
                  <% } %>
                  <% if (n.rating) { %>
                    <% 
                      let rBg = 'bg-gray-600';
                      if (n.rating === 'g') rBg = 'bg-green-600';
                      if (n.rating === 's') rBg = 'bg-yellow-600';
                      if (n.rating === 'q') rBg = 'bg-purple-600';
                      if (n.rating === 'e') rBg = 'bg-red-600';
                    %>
                    <span class="<%= rBg %> text-white text-[10px] font-bold px-2 py-0.5 rounded"><%= n.rating.toUpperCase() %></span>
                  <% } %>
                  <span class="text-xs text-gray-500"><%= new Date(n.createdAt).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %></span>
                </div>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

  <% } else { %>
    <div class="text-center py-16 bg-gray-800 rounded-lg border border-gray-700">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <p class="text-gray-400 text-lg">Belum ada notifikasi.</p>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
