<%- include('partials/header') %>

<main class="container mx-auto p-4 max-w-4xl min-h-screen pb-20">
  <div class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4 mb-6">
    <h1 class="text-2xl md:text-3xl font-bold text-white md:self-center">Daftar Notifikasi</h1>
    <% if (notifications && notifications.length > 0) { %>
      <button onclick="deleteNotification('all')" class="text-sm bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white px-3 py-1.5 rounded transition-colors font-bold flex justify-center items-center gap-1 border border-red-900/50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        Hapus Semua
      </button>
    <% } %>
  </div>

  <div id="notifications-container">
    <% if (notifications && notifications.length > 0) { 
        const grouped = {};
        notifications.forEach(n => {
           // Gunakan zona waktu Indonesia agar server production (UTC) tidak salah mengelompokkan hari
           const date = new Date(n.createdAt).toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' }); 
           if (!grouped[date]) grouped[date] = { dateStr: n.createdAt, items: [] };
           grouped[date].items.push(n);
        });
    %>
      
      <% for (const [date, group] of Object.entries(grouped)) { %>
        <div class="mb-8 notif-group" data-date="<%= date %>">
          <div class="flex justify-between items-center border-b border-gray-700 pb-2 mb-4">
            <button onclick="toggleNotifGroup(this)" class="flex items-center gap-2 flex-grow text-left group">
              <svg class="w-5 h-5 text-gray-500 transform transition-transform group-open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              <div class="flex items-center gap-2">
                <h2 class="text-xl font-bold text-gray-300 local-date" data-time="<%= group.dateStr %>"><%= date %></h2>
                <span class="bg-gray-700 text-xs text-gray-300 font-bold px-2 py-0.5 rounded-full notif-count"><%= group.items.length %></span>
              </div>
            </button>
            <button onclick="deleteNotification('day', null, '<%= group.dateStr %>')" class="text-xs text-gray-400 hover:text-red-400 transition-colors flex items-center gap-1 ml-4 flex-shrink-0">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              Hapus Hari Ini
            </button>
          </div>
          <div class="space-y-3 notif-list">
            <% group.items.forEach(n => { %>
              <div class="relative group notif-item" id="notif-<%= n.id %>">
                <div class="flex p-4 bg-gray-800 border border-gray-700 rounded-lg shadow-sm">
                  <% if (n.imageUrl) { %>
                    <a href="<%= n.link %>" class="block flex-shrink-0">
                      <img src="<%= n.imageUrl %>" class="w-24 h-24 object-cover rounded-md mr-4 hover:opacity-80 transition-opacity" alt="Thumbnail">
                    </a>
                  <% } %>
                  <div class="flex-grow flex flex-col justify-center">
                    <div class="flex items-center flex-wrap gap-2 mb-1 pr-16">
                      <div class="font-semibold text-white text-base md:text-lg"><%= n.title %></div>
                      <% if (n.extension) { %>
                        <span class="hidden sm:inline-block bg-blue-600 text-white text-[10px] font-bold px-2 py-0.5 rounded mt-0.5"><%= n.extension.toUpperCase() %></span>
                      <% } %>
                      <% if (n.rating) { %>
                        <% 
                          let rBg = 'bg-gray-600';
                          if (n.rating === 'g') rBg = 'bg-green-600';
                          if (n.rating === 's') rBg = 'bg-yellow-600';
                          if (n.rating === 'q') rBg = 'bg-purple-600';
                          if (n.rating === 'e') rBg = 'bg-red-600';
                        %>
                        <span class="<%= rBg %> text-white text-[8px] md:text-[10px] font-bold px-1.5 md:px-2 py-0.5 rounded mt-0.5"><%= n.rating.toUpperCase() %></span>
                      <% } %>
                    </div>
                    <div class="text-xs md:text-sm text-gray-300 mb-1 md:mb-1.5 leading-snug md:leading-normal"><%- n.message.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>') %></div>

                    <% 
                      let tagName = '';
                      if (n.title.startsWith('Post Baru: ')) tagName = n.title.substring(11);
                      else if (n.title.startsWith('Update Tag: ')) tagName = n.title.substring(12);
      else if (n.title === 'Konten Baru') {
        const m = n.message.match(/dari \*\*(.*?)\*\*/);
        if (m) tagName = m[1].toLowerCase().replace(/ /g, '_');
      }
                    %>
                    <div class="flex flex-nowrap gap-1.5 md:gap-2 mt-1.5 md:mt-1 w-full md:w-auto">
                      <a href="<%= n.link %>" class="flex-1 md:flex-initial bg-cyan-600 hover:bg-cyan-700 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap text-center">Lihat Detail</a>
                      <% if (tagName) { %>
                        <a href="/search?tags=<%= encodeURIComponent(tagName) %>" class="flex-1 md:flex-initial bg-gray-700 hover:bg-gray-600 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap text-center">Kunjungi Tag</a>
                      <% } %>
                    </div>
                  </div>
                </div>
                <div class="absolute top-3 right-3 flex items-center gap-1 bg-gray-800/80 backdrop-blur-sm p-1 rounded-md">
                  <span class="text-[10px] sm:text-xs text-gray-400 local-time transition-opacity" data-time="<%= n.createdAt %>"></span>
                  <button onclick="deleteNotification('single', '<%= n.id %>')" class="p-1 text-gray-400 hover:text-white hover:bg-red-600 rounded-md transition-colors opacity-100 sm:opacity-0 sm:group-hover:opacity-100" title="Hapus Notifikasi">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  </button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div id="no-notif-msg" class="text-center py-16 bg-gray-800 rounded-lg border border-gray-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <p class="text-gray-400 text-lg">Belum ada notifikasi.</p>
      </div>
    <% } %>
  </div>

  <div id="notif-loader" class="hidden text-center py-6 mt-4">
    <div class="inline-block w-8 h-8 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin mb-2"></div>
    <p class="text-sm text-cyan-400 font-bold">Memuat lebih banyak...</p>
  </div>
</main>

<script>
  // Ubah semua format tanggal/waktu ke zona waktu lokal pengguna
  document.querySelectorAll('.local-time').forEach(el => {
    const d = new Date(el.getAttribute('data-time'));
    el.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  });
  document.querySelectorAll('.local-date').forEach(el => {
    const d = new Date(el.getAttribute('data-time'));
    el.textContent = d.toLocaleDateString([], { year: 'numeric', month: 'long', day: 'numeric' });
  });

  let notifAction = null;
  
  async function deleteNotification(action, id = null, date = null) {
    if (action === 'single') {
      const item = document.getElementById(`notif-${id}`);
      if (item) {
        item.style.transition = 'all 0.3s ease';
        item.style.transform = 'translateX(-100%)';
        item.style.opacity = '0';
        setTimeout(() => {
          const group = item.closest('.notif-group');
          item.remove();
          if (group) {
            const list = group.querySelector('.notif-list');
            if (list) {
              if (list.children.length === 0) group.remove();
              else {
                const countBadge = group.querySelector('.notif-count');
                if (countBadge) countBadge.textContent = list.children.length;
              }
            }
          }
          const notifContainer = document.getElementById('notifications-container');
          if (notifContainer && notifContainer.querySelectorAll('.notif-item').length === 0) {
            window.location.reload();
          }
        }, 300);
      }
      try {
        await fetch('/api/notifications/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, id })
        });
      } catch (e) {
        console.error(e);
      }
      return;
    }

    notifAction = { action, id, date };
    let msg = "Apakah Anda yakin ingin menghapus notifikasi ini?";
    if (action === 'all') msg = "Apakah Anda yakin ingin menghapus SEMUA notifikasi?";
    if (action === 'day') msg = "Apakah Anda yakin ingin menghapus SEMUA notifikasi pada hari tersebut?";
    
    if (typeof window.showAlert === 'function') {
      window.showAlert("Hapus Notifikasi", msg, confirmDeleteNotif);
    } else {
      if (confirm(msg)) confirmDeleteNotif();
    }
  }

  async function confirmDeleteNotif() {
    if (!notifAction) return;
    try {
      const res = await fetch('/api/notifications/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(notifAction)
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      }
    } catch (e) {
      console.error(e);
    }
  }

  // Infinite Scroll
  let currentNotifPage = 1;
  let isNotifFetching = false;
  let hasMoreNotifs = "<%= notifications && notifications.length === 50 ? 'true' : 'false' %>" === "true";
  const notifLoader = document.getElementById('notif-loader');
  const notifContainer = document.getElementById('notifications-container');

  async function loadMoreNotifications() {
    if (isNotifFetching || !hasMoreNotifs) return;
    
    isNotifFetching = true;
    if (notifLoader) notifLoader.classList.remove('hidden');

    try {
      currentNotifPage++;
      const res = await fetch(`/api/notifications/more?page=${currentNotifPage}`);
      const notifs = await res.json();
      
      if (notifs.length === 0) {
        hasMoreNotifs = false;
        if (notifLoader) notifLoader.classList.add('hidden');
        return;
      }

      notifs.forEach(n => {
        const dateStr = new Date(n.createdAt).toLocaleDateString('en-CA');
        let groupDiv = notifContainer.querySelector(`.notif-group[data-date="${dateStr}"]`);
        
        if (!groupDiv) {
          // Create new group
          groupDiv = document.createElement('div');
          groupDiv.className = 'mb-8 notif-group';
          groupDiv.setAttribute('data-date', dateStr);
          groupDiv.innerHTML = `
            <div class="flex justify-between items-center border-b border-gray-700 pb-2 mb-4">
              <button onclick="toggleNotifGroup(this)" class="flex items-center gap-2 flex-grow text-left group">
                <svg class="w-5 h-5 text-gray-500 transform transition-transform group-open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                <div class="flex items-center gap-2">
                  <h2 class="text-xl font-bold text-gray-300 local-date" data-time="${n.createdAt}"></h2>
                  <span class="bg-gray-700 text-xs text-gray-300 font-bold px-2 py-0.5 rounded-full notif-count">0</span>
                </div>
              </button>
              <button onclick="deleteNotification('day', null, '${n.createdAt}')" class="text-xs text-gray-400 hover:text-red-400 transition-colors flex items-center gap-1 ml-4 flex-shrink-0">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                Hapus Hari Ini
              </button>
            </div>
            <div class="space-y-3 notif-list"></div>
          `;
          notifContainer.appendChild(groupDiv);
        }

        const listDiv = groupDiv.querySelector('.notif-list');
        
        let rBg = 'bg-gray-600';
        if (n.rating === 'g') rBg = 'bg-green-600';
        if (n.rating === 's') rBg = 'bg-yellow-600';
        if (n.rating === 'q') rBg = 'bg-purple-600';
        if (n.rating === 'e') rBg = 'bg-red-600';
        
        let tagName = '';
        if (n.title.startsWith('Post Baru: ')) tagName = n.title.substring(11);
        else if (n.title.startsWith('Update Tag: ')) tagName = n.title.substring(12);
      else if (n.title === 'Konten Baru') {
        const m = n.message.match(/dari \*\*(.*?)\*\*/);
        if (m) tagName = m[1].toLowerCase().replace(/ /g, '_');
      }

        const itemHtml = `
          <div class="relative group notif-item" id="notif-${n.id}">
            <div class="flex p-4 bg-gray-800 border border-gray-700 rounded-lg shadow-sm">
              ${n.imageUrl ? `
                <a href="${n.link}" class="block flex-shrink-0">
                  <img src="${n.imageUrl}" class="w-24 h-24 object-cover rounded-md mr-4 hover:opacity-80 transition-opacity" alt="Thumbnail">
                </a>
              ` : ''}
              <div class="flex-grow flex flex-col justify-center">
                <div class="flex items-center flex-wrap gap-2 mb-1 pr-16">
                  <div class="font-semibold text-white text-base md:text-lg">${n.title}</div>
                  ${n.extension ? `<span class="hidden sm:inline-block bg-blue-600 text-white text-[10px] font-bold px-2 py-0.5 rounded mt-0.5">${n.extension.toUpperCase()}</span>` : ''}
                  ${n.rating ? `<span class="${rBg} text-white text-[8px] md:text-[10px] font-bold px-1.5 md:px-2 py-0.5 rounded mt-0.5">${n.rating.toUpperCase()}</span>` : ''}
                </div>
                <div class="text-xs md:text-sm text-gray-300 mb-1 md:mb-1.5 leading-snug md:leading-normal">${n.message.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>')}</div>

                <div class="flex flex-nowrap gap-1.5 md:gap-2 mt-1.5 md:mt-1 w-full md:w-auto">
                  <a href="${n.link}" class="flex-1 md:flex-initial bg-cyan-600 hover:bg-cyan-700 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap text-center">Lihat Detail</a>
                  ${tagName ? `<a href="/search?tags=${encodeURIComponent(tagName)}" class="flex-1 md:flex-initial bg-gray-700 hover:bg-gray-600 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap text-center">Kunjungi Tag</a>` : ''}
                </div>
              </div>
            </div>
            <div class="absolute top-3 right-3 flex items-center gap-1 bg-gray-800/80 backdrop-blur-sm p-1 rounded-md">
              <span class="text-[10px] sm:text-xs text-gray-400 local-time transition-opacity" data-time="${n.createdAt}"></span>
              <button onclick="deleteNotification('single', '${n.id}')" class="p-1 text-gray-400 hover:text-white hover:bg-red-600 rounded-md transition-colors opacity-100 sm:opacity-0 sm:group-hover:opacity-100" title="Hapus Notifikasi">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>
          </div>
        `;
        listDiv.insertAdjacentHTML('beforeend', itemHtml);
        const countBadge = groupDiv.querySelector('.notif-count');
        if (countBadge) countBadge.textContent = listDiv.children.length;
      });
      
      if (notifs.length < 50) {
        hasMoreNotifs = false;
      }
      
      // Terapkan kembali lokalisasi waktu untuk elemen yang baru dirender
      document.querySelectorAll('.local-time').forEach(el => {
        if (!el.textContent) {
          const d = new Date(el.getAttribute('data-time'));
          el.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
      });
      document.querySelectorAll('.local-date').forEach(el => {
        if (!el.textContent) {
          const d = new Date(el.getAttribute('data-time'));
          el.textContent = d.toLocaleDateString([], { year: 'numeric', month: 'long', day: 'numeric' });
        }
      });
    } catch (err) {
      console.error(err);
    } finally {
      isNotifFetching = false;
      if (notifLoader) {
        if(!hasMoreNotifs) {
          notifLoader.innerHTML = '<p class="text-sm text-gray-500">Semua notifikasi telah dimuat.</p>';
        } else {
          notifLoader.classList.add('hidden');
        }
      }
    }
  }

  window.addEventListener('scroll', () => {
    if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 500) {
      loadMoreNotifications();
    }
  });

  // Listener untuk real-time update dari header.ejs
  window.addEventListener('notifications-updated', (e) => {
    const { notifications } = e.detail;
    if (!notifications || notifications.length === 0) return;
    
    // Reverse array to append oldest-first, so newest ends up at the top
    const newNotifs = [...notifications].reverse();
    
    newNotifs.forEach(n => {
      // Check if it already exists
      if (document.getElementById(`notif-${n.id}`)) return;
      
      const dateObj = new Date(n.createdAt);
      const dateStr = dateObj.toLocaleDateString('en-CA');
      const dateLocalStr = dateObj.toLocaleDateString([], { year: 'numeric', month: 'long', day: 'numeric' });
      const timeLocalStr = dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      
      let rBg = 'bg-gray-600';
      if (n.rating === 'g') rBg = 'bg-green-600';
      if (n.rating === 's') rBg = 'bg-yellow-600';
      if (n.rating === 'q') rBg = 'bg-purple-600';
      if (n.rating === 'e') rBg = 'bg-red-600';
      
      let tagName = '';
      if (n.title.startsWith('Post Baru: ')) tagName = n.title.substring(11);
      else if (n.title.startsWith('Update Tag: ')) tagName = n.title.substring(12);
      else if (n.title === 'Konten Baru') {
        const m = n.message.match(/dari \*\*(.*?)\*\*/);
        if (m) tagName = m[1].toLowerCase().replace(/ /g, '_');
      }

      const itemHtml = `
        <div class="relative group notif-item animate-slide-right" id="notif-${n.id}">
          <div class="flex p-4 bg-gray-800 border border-gray-700 rounded-lg shadow-sm">
            ${n.imageUrl ? `
              <a href="${n.link}" class="block flex-shrink-0">
                <img src="${n.imageUrl}" class="w-24 h-24 object-cover rounded-md mr-4 hover:opacity-80 transition-opacity" alt="Thumbnail">
              </a>
            ` : ''}
            <div class="flex-grow flex flex-col justify-center">
              <div class="flex items-center flex-wrap gap-2 mb-1 pr-16">
                <div class="font-semibold text-white text-base md:text-lg">${n.title}</div>
                ${n.extension ? `<span class="hidden sm:inline-block bg-blue-600 text-white text-[10px] font-bold px-2 py-0.5 rounded mt-0.5">${n.extension.toUpperCase()}</span>` : ''}
                ${n.rating ? `<span class="${rBg} text-white text-[8px] md:text-[10px] font-bold px-1.5 md:px-2 py-0.5 rounded mt-0.5">${n.rating.toUpperCase()}</span>` : ''}
              </div>
              <div class="text-xs md:text-sm text-gray-300 mb-1 md:mb-1.5 leading-snug md:leading-normal">${n.message.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>')}</div>
              <div class="flex flex-nowrap gap-1.5 md:gap-2 mt-1.5 md:mt-1 w-full md:w-auto">
                <a href="${n.link}" class="flex-1 md:flex-initial bg-cyan-600 hover:bg-cyan-700 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap text-center">Lihat Detail</a>
                ${tagName ? `<a href="/search?tags=${encodeURIComponent(tagName)}" class="flex-1 md:flex-initial bg-gray-700 hover:bg-gray-600 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap text-center">Kunjungi Tag</a>` : ''}
              </div>
            </div>
          </div>
          <div class="absolute top-3 right-3 flex items-center gap-1 bg-gray-800/80 backdrop-blur-sm p-1 rounded-md">
            <span class="text-[10px] sm:text-xs text-gray-400 local-time transition-opacity" data-time="${n.createdAt}">${timeLocalStr}</span>
            <button onclick="deleteNotification('single', '${n.id}')" class="p-1 text-gray-400 hover:text-white hover:bg-red-600 rounded-md transition-colors opacity-100 sm:opacity-0 sm:group-hover:opacity-100" title="Hapus Notifikasi">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        </div>
      `;
      
      // Find or create group
      let groupDiv = document.querySelector(`.notif-group[data-date="${dateStr}"]`);
      if (!groupDiv) {
        groupDiv = document.createElement('div');
        groupDiv.className = 'mb-8 notif-group';
        groupDiv.setAttribute('data-date', dateStr);
        groupDiv.innerHTML = `
          <div class="flex justify-between items-center border-b border-gray-700 pb-2 mb-4">
            <button onclick="toggleNotifGroup(this)" class="flex items-center gap-2 flex-grow text-left group">
              <svg class="w-5 h-5 text-gray-500 transform transition-transform group-open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              <div class="flex items-center gap-2">
                <h2 class="text-xl font-bold text-gray-300 local-date" data-time="${n.createdAt}">${dateLocalStr}</h2>
                <span class="bg-gray-700 text-xs text-gray-300 font-bold px-2 py-0.5 rounded-full notif-count">0</span>
              </div>
            </button>
            <button onclick="deleteNotification('day', null, '${n.createdAt}')" class="text-xs text-gray-400 hover:text-red-400 transition-colors flex items-center gap-1 ml-4 flex-shrink-0">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              Hapus Hari Ini
            </button>
          </div>
          <div class="space-y-3 notif-list"></div>
        `;
        if (notifContainer.firstChild) {
          notifContainer.insertBefore(groupDiv, notifContainer.firstChild);
        } else {
          notifContainer.appendChild(groupDiv);
        }
      }
      
      const listDiv = groupDiv.querySelector('.notif-list');
      listDiv.insertAdjacentHTML('afterbegin', itemHtml);
      const countBadge = groupDiv.querySelector('.notif-count');
      if (countBadge) countBadge.textContent = listDiv.children.length;
    });
  });

  window.toggleNotifGroup = function(btn) {
    const group = btn.closest('.notif-group');
    const list = group.querySelector('.notif-list');
    const icon = btn.querySelector('.group-open-icon');
    
    if (list.classList.contains('hidden')) {
      list.classList.remove('hidden');
      icon.classList.remove('-rotate-90');
    } else {
      list.classList.add('hidden');
      icon.classList.add('-rotate-90');
    }
  };

</script>

