<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof post !== 'undefined' ? ('CytusGallery - Post ' + post.id) : 'CytusGallery' %></title>
  <meta property="og:title" content="<%= typeof post !== 'undefined' ? ('CytusGallery - Post ' + post.id) : 'CytusGallery' %>" />
  <meta property="og:description" content="Search and explore thousand of anime imageboards more easily." />
  <meta property="og:type" content="website" />
  <% if (typeof post !== 'undefined' && post.large_file_url) { %>
  <meta property="og:image" content="<%= post.large_file_url %>" />
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="<%= post.large_file_url %>">
  <% } else { %>
  <meta property="og:image" content="/arona_doro.png" />
  <% } %>
  <meta name="theme-color" content="#0891b2" />
  <link rel="icon" type="image/png" href="/arona_doro.png">
  <link href="/css/style.css?v=3" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css" />
  <style>
    /* Prevent Flash of Unstyled Content (FOUC) for Swiper */
    .swiper:not(.swiper-initialized) {
      opacity: 0;
      pointer-events: none;
    }

    .swiper:not(.swiper-initialized) .swiper-wrapper {
      display: flex;
    }

    .swiper:not(.swiper-initialized) .swiper-slide {
      width: 100%;
      flex-shrink: 0;
    }

    @media (min-width: 640px) {
      .swiper:not(.swiper-initialized) .swiper-slide {
        width: calc(100% / 3);
      }
    }

    @media (min-width: 1024px) {
      .swiper:not(.swiper-initialized) .swiper-slide {
        width: 20%;
      }
    }

    /* Hide loader once Swiper initializes */
    .swiper.swiper-initialized~.slider-loader {
      opacity: 0;
      pointer-events: none;
    }
  </style>
</head>

<body class="bg-gray-900 text-white min-h-screen overflow-x-hidden flex flex-col">

  <div id="loading-overlay" class="fixed inset-0 bg-gray-900/80 backdrop-blur-sm z-50 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-700 ease-out">
    <div class="w-16 h-16 border-4 border-t-cyan-500 border-gray-600 rounded-full animate-spin"></div>
    <p id="loading-text" class="text-lg text-white mt-4 animate-pulse">Memuat Konten...</p>
  </div>
  <div id="custom-alert" class="fixed flex inset-0 z-50 items-center justify-center p-4 transition-opacity duration-300 ease-in-out hidden opacity-0">
    <div id="custom-alert-overlay" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

    <div id="custom-alert-box" class="relative bg-gray-800 border border-gray-700 rounded-lg shadow-xl w-11/12 max-w-md transition-all duration-300 ease-in-out transform">
      <button id="custom-alert-close" class="absolute top-3 right-3 text-gray-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <div class="p-6 flex items-start gap-4">
        <div id="custom-alert-icon-wrapper" class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-full bg-red-900/50">
          <svg id="custom-alert-icon" class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <div class="flex-grow">
          <h3 id="custom-alert-title" class="text-xl font-bold text-white">Peringatan</h3>
          <p id="custom-alert-message" class="text-sm text-gray-300 mt-2">Isi pesan akan muncul di sini.</p>
        </div>
      </div>

      <div class="bg-gray-700/50 px-6 py-3 flex justify-end gap-3 rounded-b-lg">
        <button id="custom-alert-cancel" class="px-4 py-2 bg-gray-600 text-white text-sm font-medium rounded-md hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-gray-500">
          Batal
        </button>
        <button id="custom-alert-confirm" class="px-4 py-2 bg-cyan-600 text-white text-sm font-medium rounded-md hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-cyan-500">
          Aktifkan
        </button>
        <button id="custom-alert-ok" class="hidden px-4 py-2 bg-cyan-600 text-white text-sm font-medium rounded-md hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-cyan-500">
          OK
        </button>
      </div>
    </div>
  </div>


  <div id="sidebar-overlay" class="fixed inset-0 bg-black/60 z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>

  <aside id="sidebar" class="fixed top-0 right-0 h-full w-72 bg-gray-800 shadow-lg z-50 transform translate-x-full transition-transform duration-300 overflow-y-auto">

    <div class="p-4 relative">

      <button id="close-sidebar-button" class="absolute top-4 right-4 text-gray-400 hover:text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="md:hidden pb-4 mb-4 border-b border-gray-700">
        <h2 class="text-xl font-bold text-white mb-4">Menu</h2>
        <nav class="flex flex-col space-y-1 text-gray-300">
          <% if (locals.user) { %>
          <div class="flex items-center justify-between px-3 py-2 bg-gray-700/50 rounded-md mb-2">
            <a href="/profil" class="hover:text-cyan-400 font-bold transition-colors flex items-center gap-3 flex-grow min-w-0">
              <img src="<%= user.avatarUrl || '/arona_doro.png' %>" alt="Avatar" class="w-8 h-8 rounded-full object-cover bg-gray-600 flex-shrink-0">
              <span class="truncate"><%= user.name || user.email %></span>
            </a>
            <a href="/switch-account" onclick="localStorage.removeItem('cytusGalleryActiveTab'); localStorage.removeItem('cytusGalleryFollowedTagsFilter');" class="text-gray-400 hover:text-cyan-400 p-2 transition-colors ml-2" title="Ganti Akun">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </a>
            <a href="/logout" onclick="localStorage.removeItem('cytusGalleryActiveTab'); localStorage.removeItem('cytusGalleryFollowedTagsFilter');" class="text-gray-400 hover:text-red-400 p-2 transition-colors ml-2" title="Logout">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </a>
          </div>
          <% } else { %>
          <div class="mb-2">
            <a href="/login" class="block w-full text-center px-3 py-2 rounded-md bg-cyan-600 hover:bg-cyan-700 text-white font-semibold transition-colors">Login / Daftar</a>
          </div>
          <% } %>
          <a id="home-link-mobile" href="/search" onclick="goToHome(event)" class="px-3 py-2 rounded-md hover:bg-gray-700 hover:text-white transition-colors">Beranda</a>
          <% if (locals.user) { %>
          <a href="/analitik" onclick="if(window.showLoader) window.showLoader('Memuat Analitik...'); sessionStorage.setItem('isLoadingMessage','Memuat Analitik...');" class="px-3 py-2 rounded-md hover:bg-gray-700 hover:text-white transition-colors">Analitik</a>
          <% } %>
          <a href="/tentang" class="px-3 py-2 rounded-md hover:bg-gray-700 hover:text-white transition-colors">Tentang</a>
          <a href="/bantuan" class="px-3 py-2 rounded-md hover:bg-gray-700 hover:text-white transition-colors">Bantuan</a>
        </nav>
      </div>
      <h2 class="text-xl font-bold text-white mb-6 w-3/4">Pengaturan</h2>

      <% if (locals.user) { %>
      <div class="hidden md:flex mb-4 -mt-2 gap-2">
        <a href="/switch-account" onclick="localStorage.removeItem('cytusGalleryActiveTab'); localStorage.removeItem('cytusGalleryFollowedTagsFilter');" class="w-full justify-center text-cyan-400 hover:text-cyan-300 flex items-center gap-2 text-sm font-medium transition-colors bg-gray-700/50 hover:bg-gray-700 px-3 py-2 rounded-md border border-gray-600/50 shadow-sm" title="Ganti Akun">
          <span>Ganti Akun</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </a>
        <a href="/logout" onclick="localStorage.removeItem('cytusGalleryActiveTab'); localStorage.removeItem('cytusGalleryFollowedTagsFilter');" class="w-full justify-center text-gray-400 hover:text-red-400 flex items-center gap-2 text-sm font-medium transition-colors bg-gray-700/50 hover:bg-gray-700 px-3 py-2 rounded-md border border-gray-600/50 shadow-sm" title="Logout">
          <span>Logout</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </a>
      </div>
      <% } %>

      <form action="/search" method="GET" id="filter-form">
        <div class="space-y-6 text-gray-300">
          <div>
            <div class="flex justify-between items-center mb-3">
              <h3 class="font-semibold text-white">Filter Rating</h3>
              <label for="rating-toggle" class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="rating-toggle" class="sr-only peer" checked>
                <div class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-600"></div>
              </label>
            </div>
            <div id="rating-options" class="space-y-2">
              <input type="<%= locals.isBypass ? 'checkbox' : 'radio' %>" name="rating" value="g" id="rating-g" class="hidden peer/safe">
              <label for="rating-g" class="w-full block text-start px-3 py-2 border-2 border-transparent rounded-md text-sm cursor-pointer hover:bg-gray-700 peer-checked/safe:border-green-500 peer-checked/safe:bg-green-900/50">Safe</label>
              <input type="<%= locals.isBypass ? 'checkbox' : 'radio' %>" name="rating" value="s" id="rating-s" class="hidden peer/sensitive">
              <label for="rating-s" class="w-full block text-start px-3 py-2 border-2 border-transparent rounded-md text-sm cursor-pointer hover:bg-gray-700 peer-checked/sensitive:border-yellow-500 peer-checked/sensitive:bg-yellow-900/50">Sensitive</label>
              <% if (locals.isBypass) { %>
              <input type="checkbox" name="rating" value="e" id="rating-e" class="hidden peer/explicit">
              <label for="rating-e" class="w-full block text-start px-3 py-2 border-2 border-transparent rounded-md text-sm cursor-pointer hover:bg-gray-700 peer-checked/explicit:border-red-500 peer-checked/explicit:bg-red-900/50">Explicit</label>
              <% } %>
            </div>
          </div>

          <div class="pt-6 border-t border-gray-700">
            <div class="flex justify-between items-center">
              <h3 class="font-semibold text-white">Filter Tipe</h3>
              <label for="type-toggle" class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="type-toggle" class="sr-only peer">
                <div class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-600"></div>
              </label>
            </div>
            <div id="type-options" class="hidden mt-3 space-y-2 text-sm">
              <input type="radio" name="type" value="image" id="type-image" class="hidden peer/image">
              <label for="type-image" class="w-full block text-start px-3 py-2 border-2 border-transparent rounded-md text-sm cursor-pointer hover:bg-gray-700 peer-checked/image:border-cyan-500 peer-checked/image:bg-cyan-900/50">Gambar</label>
              <input type="radio" name="type" value="video" id="type-video" class="hidden peer/video">
              <label for="type-video" class="w-full block text-start px-3 py-2 border-2 border-transparent rounded-md text-sm cursor-pointer hover:bg-gray-700 peer-checked/video:border-cyan-500 peer-checked/video:bg-cyan-900/50">Video</label>
            </div>
          </div>

          <div id="limit-input-container" class="pt-6 border-t border-gray-700">
            <label for="limit-input" class="font-semibold mb-2 block text-white">Konten per Halaman</label>
            <input type="number" name="limit" id="limit-input" value="25" min="10" max="200" class="w-full bg-gray-700 border border-gray-600 rounded-md py-2 px-3 text-white">
          </div>

          <div class="pt-6 border-t border-gray-700">
            <h3 class="font-semibold text-white mb-3">Pengaturan Lain</h3>
            <div class="space-y-4">
              <div class="flex justify-between items-center text-sm">
                <label for="autoplay-toggle">Play on Hover</label>
                <label for="autoplay-toggle" class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="autoplay-toggle" class="sr-only peer">
                  <div class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-600"></div>
                </label>
              </div>
              <div class="flex justify-between items-center text-sm">
                <label for="lazyload-toggle">Lazy Loading Gambar</label>
                <label for="lazyload-toggle" class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="lazyload-toggle" class="sr-only peer">
                  <div class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-600"></div>
                </label>
              </div>
              <div class="flex justify-between items-center text-sm">
                <label for="theme-toggle">Tema Terang</label>
                <label for="theme-toggle" class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="theme-toggle" class="sr-only peer">
                  <div class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-600"></div>
                </label>
              </div>
              <div class="flex justify-between items-center text-sm">
                <label for="scroll-toggle">Infinite Scroll</label>
                <label for="scroll-toggle" class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="scroll-toggle" class="sr-only peer">
                  <div class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-600"></div>
                </label>
              </div>
            </div>

          </div>
        </div>

        <div class="mt-8">
          <button type="submit" class="w-full text-center bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-2 px-4 rounded-md">
            Terapkan Filter
          </button>
        </div>
      </form>
    </div>
  </aside>

  <header class="sticky top-0 w-full bg-gray-800/50 backdrop-blur-md z-40">
    <nav class="container mx-auto p-4 flex justify-between items-center relative">
      <div class="flex justify-center items-center gap-3">
        <img src="/arona_doro.png" alt="CytusGallery Logo" width="30" height="30" class="flex-shrink-0">
        <a id="brand-link" href="/search" onclick="goToHome(event)" class="text-2xl font-bold text-cyan-400 flex-shrink-0">CytusGallery</a>
      </div>

      <div class="flex items-center gap-6">
        <div class="hidden md:flex items-center gap-6 text-gray-300">
          <a id="home-link" href="/search" onclick="goToHome(event)" class="hover:text-white transition-colors">Home</a>
          <% if (locals.user) { %>
          <a href="/analitik" onclick="if(window.showLoader) window.showLoader('Memuat Analitik...'); sessionStorage.setItem('isLoadingMessage','Memuat Analitik...');" class="hover:text-white transition-colors">Analitik</a>
          <% } %>
          <a href="/tentang" class="hover:text-white transition-colors">Tentang</a>
          <a href="/bantuan" class="hover:text-white transition-colors">Bantuan</a>
          <% if (locals.user) { %>
          <div class="relative flex items-center gap-4 bg-gray-700/50 px-3 py-2 rounded-full border border-gray-600/50">
            <div class="flex items-center mt-1">
              <button id="notification-btn" class="relative text-gray-300 hover:text-white transition-colors focus:outline-none block">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                <span id="notification-badge" class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full <%= locals.unreadCount > 0 ? '' : 'hidden' %>"><%= locals.unreadCount > 99 ? '99+' : (locals.unreadCount || 0) %></span>
              </button>
            </div>

            <div id="desktop-notification-dropdown" class="absolute right-0 top-full mt-4 w-80 bg-gray-800 rounded-md shadow-2xl overflow-hidden z-50 hidden border border-gray-700 flex flex-col cursor-default">
              <div class="p-3 border-b border-gray-700 font-bold text-white flex justify-between items-center shrink-0">
                Notifikasi
              </div>
              <div class="notification-list max-h-64 overflow-y-auto flex-grow">
                <div class="p-4 text-sm text-gray-400 text-center">Memuat...</div>
              </div>
              <div class="p-2 bg-gray-900 border-t border-gray-700 text-center shrink-0">
                <a href="/notifikasi" class="text-sm text-cyan-400 hover:text-cyan-300 font-bold block py-1">Lihat Semua Notifikasi</a>
              </div>
            </div>

            <div class="h-6 w-px bg-gray-600"></div>
            <a href="/profil" class="hover:text-cyan-400 font-bold transition-colors flex items-center gap-2">
              <span class="truncate max-w-[150px]"><%= user.name || user.email %></span>
              <img src="<%= user.avatarUrl || '/arona_doro.png' %>" alt="Avatar" class="w-8 h-8 rounded-full object-cover bg-gray-600 flex-shrink-0">
            </a>
          </div>
          <% } else { %>
          <a href="/login" class="bg-cyan-600 hover:bg-cyan-700 text-white px-3 py-1 rounded transition-colors">Login</a>
          <% } %>
        </div>

        <div class="flex items-center gap-5">
          <% if (locals.user) { %>
          <button id="mobile-notification-btn" class="md:hidden relative text-gray-300 hover:text-white transition-colors block mr-4 focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span id="mobile-notification-badge" class="absolute -top-1 -right-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full <%= locals.unreadCount > 0 ? '' : 'hidden' %>"><%= locals.unreadCount > 99 ? '99+' : (locals.unreadCount || 0) %></span>
          </button>
          <% } %>
          <button id="open-sidebar-button" class="space-y-2 cursor-pointer">
            <span class="block w-8 h-0.5 bg-gray-100"></span>
            <span class="block w-8 h-0.5 bg-gray-100"></span>
            <span class="block w-8 h-0.5 bg-gray-100"></span>
          </button>
        </div>
      </div>

      <div id="mobile-notification-dropdown" class="absolute right-4 top-full mt-2 w-[90vw] sm:w-80 max-w-sm bg-gray-800 rounded-md shadow-2xl overflow-hidden z-50 hidden border border-gray-700 flex flex-col cursor-default">
        <div class="p-3 border-b border-gray-700 font-bold text-white flex justify-between items-center shrink-0">
          Notifikasi
        </div>
        <div class="notification-list max-h-64 overflow-y-auto flex-grow">
          <div class="p-4 text-sm text-gray-400 text-center">Memuat...</div>
        </div>
        <div class="p-2 bg-gray-900 border-t border-gray-700 text-center shrink-0">
          <a href="/notifikasi" class="text-sm text-cyan-400 hover:text-cyan-300 font-bold block py-1">Lihat Semua Notifikasi</a>
        </div>
      </div>
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const currentPath = window.location.pathname;
          const navLinks = document.querySelectorAll('header nav a[href], #sidebar nav a[href]');
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === currentPath || (currentPath === '/' && href === '/search')) {
              link.classList.remove('text-gray-300', 'text-gray-400');
              link.classList.add('text-cyan-400', 'font-bold');
            }
          });
        });
      </script>
    </nav>
