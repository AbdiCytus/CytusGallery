<% relatedPosts.forEach((post, index) => { %>
  <% const isVideo = post.file_ext === 'mp4' || post.file_ext === 'webm'; %>
  <% const isZip = post.file_ext === 'zip'; %>
  <% const previewUrl = (isVideo || isZip) ? (post.media_asset?.variants?.find(v => v.type === '720x720')?.url || post.media_asset?.variants?.find(v => v.type === '360x360')?.url || post.preview_file_url) : ''; %>
  <% const videoUrl = isVideo ? post.large_file_url : (isZip ? (post.media_asset?.variants?.find(v => v.file_ext === 'webm' || v.file_ext === 'mp4')?.url || '') : ''); %>
  <% const isSavedRelated = locals.savedPostIds ? savedPostIds.has(post.id.toString()) : false; %>
  <div class="group gallery-item relative bg-gray-800 rounded-lg overflow-hidden aspect-[3/4] shadow-md hover:shadow-cyan-500/20 transition-all duration-300 <%= isSavedRelated ? 'border-4 border-yellow-500' : '' %>" data-post-url="/posts/<%= post.id %>" data-is-video="<%= !!(isVideo || (isZip && videoUrl)) %>" data-video-url="<%= videoUrl %>" data-preview-url="<%= previewUrl %>">
    <div class="absolute top-0 left-0 z-20 bg-black/50 text-white text-xs px-2 py-1 rounded-br-md pointer-events-none transition-opacity duration-300 group-hover:opacity-0 [.mobile-active_&]:opacity-0">
      <%= (locals.page ? (locals.page - 1) * 25 : 0) + index + 1 %>
    </div>
    <div class="absolute top-0 right-0 z-20 flex pointer-events-none transition-opacity duration-300 group-hover:opacity-0 [.mobile-active_&]:opacity-0 drop-shadow-md">
      <% if ((isVideo || isZip) && post.media_asset && post.media_asset.duration) { %>
        <% 
          const durationSec = Math.floor(post.media_asset.duration);
          const m = Math.floor(durationSec / 60).toString().padStart(2, '0');
          const s = (durationSec % 60).toString().padStart(2, '0');
        %>
        <span class="bg-gray-800/80 text-white text-[10px] font-bold px-2 py-1 shadow-sm"><%= m %>:<%= s %></span>
      <% } %>
      <span class="bg-blue-600 text-white text-[10px] font-bold px-2 py-1 rounded-bl-md shadow-sm"><%= post.file_ext.toUpperCase() %></span>
      <% if (post.rating) { %>
        <% 
          let ratingColor = '';
          switch (post.rating) {
              case 'g': ratingColor = 'bg-green-600'; break;
              case 's': ratingColor = 'bg-yellow-600'; break;
              case 'q': ratingColor = 'bg-purple-600'; break;
              case 'e': ratingColor = 'bg-red-600'; break;
          }
        %>
        <span class="<%= ratingColor %> text-white text-[10px] font-bold px-2 py-1 shadow-sm"><%= post.rating.toUpperCase() %></span>
      <% } %>
    </div>

    <div class="media-container relative w-full h-full bg-black">
      <% if (isVideo || isZip) { %>
      <img src="<%= previewUrl %>" alt="Preview" class="video-preview absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy">
      <% if (isVideo || (isZip && videoUrl)) { %>
      <video class="video-playback hidden absolute inset-0 w-full h-full object-cover" preload="none" loop muted playsinline></video>
      <% } %>
      <% } else { %>
      <img src="<%= post.large_file_url %>" alt="Related content" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy">
      <% } %>
    </div>

    <div class="overlay absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent p-3 flex flex-col justify-end text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none group-hover:pointer-events-auto [.mobile-active_&]:opacity-100 [.mobile-active_&]:pointer-events-auto">
      <div class="overlay-content">
        <% 
          // Re-implement getDisplayTags since it's defined in detail.ejs
          const getDisplayTags = (postData) => {
            if (postData.tag_string_character) {
              const chars = postData.tag_string_character.split(' ');
              const title = chars.slice(0, 2).map(c => c.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())).join(', ');
              const copyright = postData.tag_string_copyright ? postData.tag_string_copyright.split(' ')[0].replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) : 'Original';
              return { title: title + (chars.length > 2 ? '...' : ''), subtitle: copyright };
            }
            if (postData.tag_string_copyright) {
              const copies = postData.tag_string_copyright.split(' ');
              const title = copies[0].replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
              const artist = postData.tag_string_artist ? postData.tag_string_artist.split(' ')[0].replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) : 'Unknown Artist';
              return { title: title, subtitle: artist };
            }
            if (postData.tag_string_artist) {
              const artists = postData.tag_string_artist.split(' ');
              const title = artists[0].replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
              return { title: title, subtitle: 'Original' };
            }
            return { title: 'Untitled', subtitle: 'Unknown' };
          };
          const displayTags = getDisplayTags(post); 
        %>
        <h4 class="text-sm font-bold truncate"><%= displayTags.title %></h4>
        <p class="text-xs text-gray-300 truncate"><%= displayTags.subtitle %></p>
        
        <div class="flex gap-2 mt-2">
          <a href="/posts/<%= post.id %>" class="detail-button flex-grow text-center bg-cyan-600 text-xs py-1.5 rounded-md hover:bg-cyan-700 transition-colors">Lihat Detail</a>
          <% if (locals.user) { %>
          <button onclick="savePostOverlay(event, '<%= post.id %>', this)" class="<%= isSavedRelated ? 'bg-green-600 hover:bg-green-700' : 'bg-gray-700 hover:bg-gray-600' %> text-white px-3 py-1.5 rounded-md transition-colors flex items-center justify-center shadow-sm" title="Simpan ke Koleksi">
            <% if (isSavedRelated) { %>
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
            <% } else { %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
            <% } %>
          </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<% }); %>
