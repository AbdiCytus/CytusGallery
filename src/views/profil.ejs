<!DOCTYPE html>
<html lang="id">
<%- include('partials/header.ejs') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
  // Show loading on profile page reload & clear filters
  window.addEventListener('beforeunload', function() {
    sessionStorage.setItem('isLoadingMessage', 'Memuat Halaman...');
  });
  if (window.performance && window.performance.navigation.type === 1 && window.location.search) {
    window.location.replace('/profil');
  }
</script>
<style>
  .gallery-item.selected-item {
    border: 4px solid #3b82f6 !important;
    opacity: 0.8 !important;
  }
</style>
<main class="w-full px-4 py-8 flex-grow">
  <div class="w-full md:w-[90vw] mx-auto bg-gray-800 rounded-lg shadow-xl shadow-cyan-900/10 p-6 md:p-8 border border-gray-700">
    <div class="flex flex-col items-center gap-6 w-full">
      <div class="flex-shrink-0">
        <% if (userProfile.avatarUrl) { %>
        <img src="<%= userProfile.avatarUrl %>" alt="Profile" class="w-32 h-32 rounded-full border-4 border-cyan-600 object-cover shadow-lg">
        <% } else { %>
        <div class="w-32 h-32 rounded-full bg-cyan-700 flex items-center justify-center text-4xl font-bold text-white border-4 border-gray-600 shadow-lg">
          <%= (userProfile.name || userProfile.email).charAt(0).toUpperCase() %>
        </div>
        <% } %>
      </div>
      <div class="text-center w-full">
        <h1 class="text-3xl font-bold text-white"><%= userProfile.name || "User CytusGallery" %></h1>
        <p class="text-gray-400 mt-2"><%= userProfile.email %></p>
        <p class="text-xs text-gray-500 mt-1">Bergabung sejak: <%= new Date(userProfile.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>

        <div class="mt-6 w-full md:max-w-[400px] gap-3 justify-center items-center mx-auto" style="display: grid; grid-template-columns: repeat(2, 1fr);">
          <form id="avatar-form" action="/api/profil/upload" method="POST" enctype="multipart/form-data" class="flex" style="grid-column: span 2;">
            <input type="file" name="avatar" id="avatar-input" accept="image/*" class="hidden">
            <button type="button" onclick="document.getElementById('avatar-input').click()" class="w-full bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-md font-medium transition-colors border border-gray-600 flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Ganti Foto
            </button>
          </form>
          <a href="/logout" onclick="localStorage.removeItem('cytusGalleryActiveTab'); localStorage.removeItem('cytusGalleryFollowedTagsFilter');" class="col-span-1 text-center bg-red-600/20 hover:bg-red-600 text-red-400 hover:text-white px-5 py-2 rounded-md font-medium transition-colors border border-red-900/50 shadow-sm flex items-center justify-center">
            Logout
          </a>
          <button onclick="deleteAccount()" class="col-span-1 bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-md font-medium transition-colors shadow-lg flex items-center justify-center">
            Hapus Akun
          </button>
        </div>
        <p id="avatar-msg" class="text-xs mt-2 hidden text-center"></p>


        <!-- Client-side Zipping Libraries -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
        <script>
          function deleteAccount() {
            if (typeof window.showAlert === 'function') {
              window.showAlert("Hapus Akun", "Apakah Anda yakin ingin menghapus akun Anda secara permanen? Semua data koleksi dan notifikasi akan hilang!", confirmDeleteAccount);
            } else {
              if (confirm("Apakah Anda yakin ingin menghapus akun Anda secara permanen? Semua data koleksi dan notifikasi akan hilang!")) {
                confirmDeleteAccount();
              }
            }
          }

          function confirmDeleteAccount() {
            fetch('/api/profil/delete', {
                method: 'DELETE'
              })
              .then(res => res.json())
              .then(data => {
                if (data.success) {
                  window.location.href = '/';
                } else {
                  if (typeof window.showAlert === 'function') {
                    window.showAlert("Gagal", data.error || "Gagal menghapus akun.", null);
                  } else {
                    alert(data.error || "Gagal menghapus akun.");
                  }
                }
              })
              .catch(err => {
                if (typeof window.showAlert === 'function') {
                  window.showAlert("Error", "Terjadi kesalahan saat menghapus akun.", null);
                } else {
                  alert("Terjadi kesalahan saat menghapus akun.");
                }
              });
          }
          let cropper = null;
          document.getElementById('avatar-input').addEventListener('change', function(e) {
            if (!this.files || !this.files[0]) return;
            const file = this.files[0];
            const reader = new FileReader();
            reader.onload = function(event) {
              const image = document.getElementById('crop-image');
              image.src = event.target.result;
              const cropModal = document.getElementById('crop-modal');
              cropModal.classList.remove('hidden');
              cropModal.classList.add('flex');
              if (cropper) cropper.destroy();
              cropper = new Cropper(image, {
                aspectRatio: 1,
                viewMode: 1,
                autoCropArea: 1,
              });
            };
            reader.readAsDataURL(file);
            this.value = ''; // reset input
          });

          const closeCropModal = () => {
            const cropModal = document.getElementById('crop-modal');
            if (cropModal) {
              cropModal.classList.add('hidden');
              cropModal.classList.remove('flex');
            }
            if (cropper) cropper.destroy();
            cropper = null;
          };

          document.addEventListener('DOMContentLoaded', () => {
            const cancelBtn = document.getElementById('crop-cancel-btn');
            const closeBtn = document.getElementById('crop-close-btn');
            const saveBtn = document.getElementById('crop-save-btn');

            if (cancelBtn) cancelBtn.addEventListener('click', closeCropModal);
            if (closeBtn) closeBtn.addEventListener('click', closeCropModal);

            if (saveBtn) {
              saveBtn.addEventListener('click', async function() {
                if (!cropper) return;
                const msgEl = document.getElementById('avatar-msg');
                msgEl.textContent = "Mengunggah...";
                msgEl.className = "text-xs mt-2 text-yellow-400 text-center md:text-left block";

                const canvas = cropper.getCroppedCanvas({
                  width: 256,
                  height: 256,
                  fillColor: '#fff',
                  imageSmoothingEnabled: false,
                  imageSmoothingQuality: 'high',
                });

                closeCropModal();

                if (!canvas) {
                  msgEl.textContent = "Gagal memproses gambar.";
                  msgEl.className = "text-xs mt-2 text-red-400 text-center md:text-left block";
                  return;
                }

                canvas.toBlob(async (blob) => {
                  const formData = new FormData();
                  formData.append('avatar', blob, 'avatar.png');

                  if (typeof window.showLoader === 'function') window.showLoader("Mengunggah foto...");
                  try {
                    const res = await fetch('/api/profil/upload', {
                      method: 'POST',
                      body: formData
                    });
                    const data = await res.json();
                    if (res.ok) {
                      msgEl.textContent = data.message;
                      msgEl.className = "text-xs mt-2 text-green-400 text-center md:text-left block";
                      setTimeout(() => window.location.reload(), 1000);
                    } else {
                      throw new Error(data.error);
                    }
                  } catch (err) {
                    if (typeof window.hideLoader === 'function') window.hideLoader();
                    msgEl.textContent = err.message || "Gagal mengunggah.";
                    msgEl.className = "text-xs mt-2 text-red-400 text-center md:text-left block";
                  }
                }, 'image/png');
              });
            }
          });
        </script>
      </div>
    </div>

    <!-- Tabs Header -->
    <div class="mt-8 border-b border-gray-700 flex">
      <button id="tab-koleksi-btn" class="py-3 px-6 text-cyan-400 border-b-2 border-cyan-400 font-bold focus:outline-none transition-colors">
        Koleksi (<%= typeof totalSaves !== 'undefined' ? totalSaves : userProfile.saves.length %>)
      </button>
      <button id="tab-mengikuti-btn" class="py-3 px-6 text-gray-400 hover:text-white font-bold focus:outline-none transition-colors">
        Mengikuti (<%= userProfile.followedTags ? userProfile.followedTags.length : 0 %>)
      </button>
    </div>

    <!-- Batch Actions Floating Bar -->
    <div id="batch-action-bar" class="fixed left-0 w-full bg-gray-900 border-t border-cyan-700 shadow-2xl p-3 sm:p-4 transition-transform duration-300" style="bottom: 0; transform: translateY(100%); z-index: 99999;">
      <div class="container mx-auto flex items-center justify-center gap-4 sm:gap-6">
        <div class="text-cyan-400 font-bold text-sm sm:text-base whitespace-nowrap"><span id="selected-count">0</span> Dipilih</div>
        <div class="flex flex-wrap gap-2 sm:gap-3 justify-center">
          <button id="batch-delete-btn" class="bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 sm:py-2 rounded font-medium transition-colors flex items-center justify-center" title="Hapus">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
          <button id="batch-download-btn" class="bg-cyan-600 hover:bg-cyan-500 text-white px-3 py-1.5 sm:py-2 rounded font-medium transition-colors flex items-center justify-center gap-1" title="Download">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </button>
          <button id="batch-select-all-btn" class="bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 sm:py-2 rounded font-medium transition-colors flex items-center justify-center" title="Pilih Semua">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </button>
          <button id="batch-cancel-btn" class="bg-gray-600 hover:bg-gray-500 text-white px-3 py-1.5 sm:py-2 rounded font-medium transition-colors flex items-center justify-center" title="Batal">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Tab Koleksi Content -->
    <div id="tab-koleksi-content" class="pt-6 block">
      <% if (userProfile.saves.length > 0 || (typeof currentSearch !== 'undefined' && currentSearch !== '') || (typeof currentRating !== 'undefined' && currentRating !== '')) { %>
      <!-- Filter, Search, and View Toggle -->
      <form id="profil-form" action="/profil" method="GET" class="grid grid-cols-2 sm:flex sm:flex-row items-center gap-4 mb-4 w-full relative z-20">

        <!-- Rating Filter: Mobile Row 2 Left, Desktop Left -->
        <div class="relative order-2 sm:order-1 col-span-1">
          <select name="rating" class="appearance-none bg-gray-700 text-white rounded px-4 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-cyan-500 hover:bg-gray-600 transition-colors cursor-pointer text-sm font-semibold w-full sm:w-auto">
            <option value="" <%= typeof currentRating !== 'undefined' && currentRating === '' ? 'selected' : '' %>>Semua Rating</option>
            <option value="g" <%= typeof currentRating !== 'undefined' && currentRating === 'g' ? 'selected' : '' %>>Safe</option>
            <option value="s" <%= typeof currentRating !== 'undefined' && currentRating === 's' ? 'selected' : '' %>>Sensitive</option>
            <% if (locals.isBypass) { %>
            <option value="e" <%= typeof currentRating !== 'undefined' && currentRating === 'e' ? 'selected' : '' %>>Explicit</option>
            <% } %>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-white">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>

        <!-- Search Input: Mobile Row 1 Full Width, Desktop Center -->
        <div class="relative w-full col-span-2 sm:order-2 flex-grow order-1">
          <input type="text" name="search" id="koleksi-search-input" value="<%= typeof currentSearch !== 'undefined' ? currentSearch : '' %>" class="w-full bg-gray-700 text-white rounded px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 placeholder-gray-400" placeholder="Cari koleksi..." autocomplete="off">
        </div>

        <button type="submit" class="hidden">Cari</button>

        <!-- View Toggles: Mobile Row 2 Right, Desktop Right -->
        <div class="flex justify-end gap-2 shrink-0 order-3 sm:order-3 col-span-1">
          <button type="button" id="select-mode-btn" class="p-2 bg-gray-700 text-gray-400 hover:text-white rounded focus:outline-none transition-colors" title="Mode Pilihan">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </button>
          <button type="button" id="view-grid-btn" class="p-2 bg-cyan-600 text-white rounded focus:outline-none transition-colors" title="Tampilan Grid">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"></path>
            </svg>
          </button>
          <button type="button" id="view-data-btn" class="p-2 bg-gray-700 text-gray-400 hover:text-white rounded focus:outline-none transition-colors" title="Tampilan Data">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
            </svg>
          </button>
        </div>
      </form>
      <% } %>
      <div id="koleksi-results">
      <% if (userProfile.saves.length > 0) { %>
      <!-- Grid View -->
      <div id="koleksi-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <% userProfile.saves.forEach((save, index) => { 
             const isVideo = (save.extension === 'mp4' || save.extension === 'webm');
             const isZip = (save.extension === 'zip');
             const videoUrl = isVideo ? save.fileUrl : (isZip && save.fileUrl ? save.fileUrl.replace(/\.zip$/i, '.webm') : '');
          %>
        <div class="group gallery-item relative bg-gray-900 rounded-lg overflow-hidden aspect-[3/4] border border-gray-700 shadow-md hover:shadow-cyan-900/30 transition-all duration-300 cursor-pointer" data-post-url="/posts/<%= save.postId %>" data-is-video="<%= !!(isVideo || (isZip && videoUrl)) %>" data-video-url="<%= videoUrl %>">
          <div class="absolute top-0 left-0 z-30 bg-black/50 text-white text-xs px-2 py-1 rounded-br-md pointer-events-none transition-opacity duration-300 group-hover:opacity-0 [.mobile-active_&]:opacity-0">
            <%= index + 1 %>
          </div>
          <div class="absolute top-0 right-0 z-30 flex pointer-events-none transition-opacity duration-300 group-hover:opacity-0 [.mobile-active_&]:opacity-0">
            <span class="bg-blue-600 text-white text-[10px] font-bold px-2 py-1 rounded-bl-md shadow-sm"><%= (save.extension || 'unk').toUpperCase() %></span><% if (save.rating) { %><% 
            let ratingColor = '';
            switch (save.rating) {
                case 'g': ratingColor = 'bg-green-600'; break;
                case 's': ratingColor = 'bg-yellow-600'; break;
                case 'q': ratingColor = 'bg-purple-600'; break;
                case 'e': ratingColor = 'bg-red-600'; break;
            }
            %><span class="<%= ratingColor %> text-white text-[10px] font-bold px-2 py-1 shadow-sm"><%= save.rating.toUpperCase() %></span><% } %>
          </div>
          <% if ((isVideo || isZip) && videoUrl) { %>
          <div class="media-container relative w-full h-full bg-black">
            <img src="<%= save.imageUrl %>" class="absolute inset-0 w-full h-full object-cover video-preview transition-transform duration-500 group-hover:scale-110" alt="Saved Post <%= save.postId %>" loading="lazy">
            <video src="<%= videoUrl %>" class="absolute inset-0 w-full h-full object-cover video-playback hidden" muted loop playsinline></video>
            <div class="absolute top-2 left-2 bg-black/60 rounded-full p-1 video-indicator z-20">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M4 4l12 6-12 6z"></path>
              </svg>
            </div>
          </div>
          <% } else if (save.imageUrl) { %>
          <div class="media-container relative w-full h-full bg-black">
            <img src="<%= save.imageUrl %>" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" alt="Saved Post <%= save.postId %>" loading="lazy">
          </div>
          <% } else { %>
          <div class="media-container relative w-full h-full bg-gray-800 flex items-center justify-center p-4 text-center">
            <span class="text-sm font-medium text-cyan-400 break-all">ID: <%= save.postId %></span>
          </div>
          <% } %>
          <div class="overlay absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-3 flex flex-col justify-end text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none group-hover:pointer-events-auto [.mobile-active_&]:opacity-100 [.mobile-active_&]:pointer-events-auto">
            <div class="overlay-content">
              <h4 class="font-bold truncate text-sm capitalize"><%= save.character %></h4>
              <p class="text-xs text-gray-400 truncate capitalize"><%= save.copyright %></p>
              <div class="flex gap-2 mt-2">
                <a href="/posts/<%= save.postId %>" class="detail-button flex-grow bg-cyan-600 hover:bg-cyan-700 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md transition-colors flex items-center justify-center shadow-sm text-xs font-semibold" title="Lihat Detail">
                  Lihat Detail
                </a>
                <button onclick="removeSave('<%= save.postId %>', this, false)" class="bg-red-600 hover:bg-red-700 text-white px-2 py-1 md:px-3 md:py-1.5 rounded-md transition-colors flex items-center justify-center shadow-sm" title="Hapus dari Koleksi">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>

      <!-- Data View -->
      <div id="koleksi-data" class="flex flex-col gap-3 hidden">
        <% userProfile.saves.forEach(save => { %>
        <div class="flex flex-col sm:flex-row bg-gray-900 border border-gray-700 rounded-lg overflow-hidden group hover:shadow-cyan-900/20 transition-all">
          <a href="/posts/<%= save.postId %>" class="flex-grow flex flex-col sm:flex-row hover:bg-gray-800/50 transition-colors">
            <div class="w-full h-48 sm:w-28 sm:h-28 flex-shrink-0 relative bg-gray-800">
              <% if (save.imageUrl) { %>
              <img src="<%= save.imageUrl %>" class="w-full h-full object-cover transition-opacity" style="object-position: top" alt="Saved Post <%= save.postId %>" loading="lazy">
              <% } else { %>
              <div class="w-full h-full flex items-center justify-center p-2 text-center">
                <span class="text-xs font-medium text-cyan-400 break-all">ID: <%= save.postId %></span>
              </div>
              <% } %>
            </div>
            <div class="p-4 flex flex-col justify-center">
              <div class="font-bold text-white mb-2">Post ID: <%= save.postId %></div>
              <div class="flex flex-wrap gap-2 text-xs">
                <div class="bg-gray-800 border border-gray-700 px-2 py-1 rounded flex items-center gap-1 shadow-sm">
                  <span class="text-gray-400 font-medium">Ext:</span>
                  <span class="font-bold text-cyan-400"><%= (save.fileUrl || save.imageUrl || 'unk.unk').split('.').pop().toUpperCase() %></span>
                </div>
                <div class="bg-gray-800 border border-gray-700 px-2 py-1 rounded flex items-center gap-1 shadow-sm">
                  <span class="text-gray-400 font-medium">Rating:</span>
                  <span class="font-bold text-white"><%= save.rating ? save.rating.toUpperCase() : 'N/A' %></span>
                </div>
                <div class="bg-gray-800 border border-gray-700 px-2 py-1 rounded flex items-center gap-1 shadow-sm">
                  <span class="text-gray-400 font-medium">Score:</span>
                  <span class="font-bold text-green-400"><%= save.score || 0 %></span>
                </div>
                <div class="bg-gray-800 border border-gray-700 px-2 py-1 rounded flex items-center gap-1 shadow-sm">
                  <span class="text-gray-400 font-medium">Size:</span>
                  <span class="font-bold text-white"><%= save.size ? (save.size / 1024 / 1024).toFixed(2) + ' MB' : 'N/A' %></span>
                </div>
                <div class="bg-gray-800 border border-gray-700 px-2 py-1 rounded flex items-center gap-1 shadow-sm">
                  <span class="text-gray-400 font-medium">Up:</span>
                  <span class="font-bold text-white"><%= save.uploadedAt ? new Date(save.uploadedAt).toLocaleDateString('id-ID') : 'N/A' %></span>
                </div>
                <div class="bg-gray-800 border border-gray-700 px-2 py-1 rounded flex items-center gap-1 shadow-sm">
                  <span class="text-gray-400 font-medium">Save:</span>
                  <span class="font-bold text-white"><%= save.savedAt ? new Date(save.savedAt).toLocaleDateString('id-ID') : 'N/A' %></span>
                </div>
              </div>
            </div>
          </a>
          <div class="p-4 flex flex-col sm:border-l border-t sm:border-t-0 border-gray-700 bg-gray-900 shrink-0 sm:w-48">
            <div class="w-full mt-auto flex flex-col gap-2">
              <% if (save.source) { 
                     let sourceName = 'Source';
                     try {
                        let url = new URL(save.source);
                        let hostname = url.hostname.replace('www.', '');
                        sourceName = hostname.split('.')[0];
                     } catch(e) { sourceName = 'Source'; }
                  %>
              <a href="<%= save.source %>" target="_blank" class="w-full justify-center text-sm bg-gray-700 hover:bg-gray-600 text-cyan-300 font-bold px-4 py-2 rounded transition-colors capitalize flex items-center gap-1 shadow-sm overflow-hidden">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                <span class="truncate">Source: <%= sourceName %></span>
              </a>
              <% } %>
              <div class="flex gap-2 w-full">
                <% if (save.fileUrl) { %>
                <button onclick="forceDownload('<%= save.fileUrl %>', 'CytusGallery_<%= save.postId %>', this)" class="flex-grow justify-center text-sm bg-cyan-600 hover:bg-cyan-700 text-white font-bold px-3 py-2 rounded transition-colors flex items-center gap-1 shadow-sm text-center" title="Download">
                  <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                </button>
                <% } %>
                <button onclick="removeSave('<%= save.postId %>', this, false)" class="flex-grow justify-center text-sm bg-red-600 hover:bg-red-700 text-white font-bold px-3 py-2 rounded transition-colors flex items-center gap-1 shadow-sm" title="Hapus">
                  <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>

      <div id="koleksi-loader" class="hidden text-center py-6 mt-4">
        <div class="inline-block w-8 h-8 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin mb-2"></div>
        <p class="text-sm text-cyan-400 font-bold">Memuat lebih banyak...</p>
      </div>
      <% } else { %>
      <div class="bg-gray-700/30 rounded-lg p-8 text-center border border-gray-700 border-dashed">
        <svg class="w-16 h-16 text-gray-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 4v16l7-4 7 4V4H5z"></path>
        </svg>
        <p class="text-gray-400">Belum ada konten yang disimpan.</p>
        <a href="/search" class="inline-block mt-4 text-cyan-400 hover:text-cyan-300 hover:underline">Jelajahi konten</a>
      </div>
      <% } %>
      </div>
    </div>

    <!-- Tab Mengikuti Content -->
    <div id="tab-mengikuti-content" class="pt-6 hidden">
      <% 
        const followed = userProfile.followedTags || [];
        const copyrights = followed.filter(t => t.tagType === 3);
        const characters = followed.filter(t => t.tagType === 4);
        const artists = followed.filter(t => t.tagType === 1);
      %>

      <% if (followed.length > 0) { %>
      <% if (copyrights.length > 0) { %>
      <div class="mb-6">
        <h3 class="text-lg font-bold text-white mb-3 border-b border-gray-700 pb-1">Copyright <span class="text-gray-500 text-sm font-normal">(<%= copyrights.length %>)</span></h3>
        <div class="flex flex-wrap gap-2">
          <% copyrights.forEach(item => { %>
          <div class="bg-gray-800 hover:bg-gray-700 border border-gray-700 text-purple-400 pl-3 pr-3 py-1 rounded-full text-sm transition-colors flex items-center shadow-sm">
            <a href="/search?tags=<%= encodeURIComponent(item.tagName) %>" class="font-medium hover:underline py-0.5"><%= item.tagName.replace(/_/g, ' ') %></a>
            <button data-tagname="<%= item.tagName %>" data-tagtype="<%= item.tagType %>" onclick="unfollowTag(this.dataset.tagname, parseInt(this.dataset.tagtype), this)" class="text-gray-500 hover:text-red-400 hover:bg-red-500/20 focus:outline-none transition-colors mr-3 rounded-full ml-1" title="Unfollow">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (characters.length > 0) { %>
      <div class="mb-6">
        <h3 class="text-lg font-bold text-white mb-3 border-b border-gray-700 pb-1">Character <span class="text-gray-500 text-sm font-normal">(<%= characters.length %>)</span></h3>
        <div class="flex flex-wrap gap-2">
          <% characters.forEach(item => { %>
          <div class="bg-gray-800 hover:bg-gray-700 border border-gray-700 text-green-400 pl-3 pr-3 py-1 rounded-full text-sm transition-colors flex items-center shadow-sm">
            <a href="/search?tags=<%= encodeURIComponent(item.tagName) %>" class="font-medium hover:underline py-0.5"><%= item.tagName.replace(/_/g, ' ') %></a>
            <button data-tagname="<%= item.tagName %>" data-tagtype="<%= item.tagType %>" onclick="unfollowTag(this.dataset.tagname, parseInt(this.dataset.tagtype), this)" class="text-gray-500 hover:text-red-400 hover:bg-red-500/20 focus:outline-none transition-colors mr-3 rounded-full ml-1" title="Unfollow">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (artists.length > 0) { %>
      <div class="mb-6">
        <h3 class="text-lg font-bold text-white mb-3 border-b border-gray-700 pb-1">Artist <span class="text-gray-500 text-sm font-normal">(<%= artists.length %>)</span></h3>
        <div class="flex flex-wrap gap-2">
          <% artists.forEach(item => { %>
          <div class="bg-gray-800 hover:bg-gray-700 border border-gray-700 text-red-400 pl-3 pr-3 py-1 rounded-full text-sm transition-colors flex items-center shadow-sm">
            <a href="/search?tags=<%= encodeURIComponent(item.tagName) %>" class="font-medium hover:underline py-0.5"><%= item.tagName.replace(/_/g, ' ') %></a>
            <button data-tagname="<%= item.tagName %>" data-tagtype="<%= item.tagType %>" onclick="unfollowTag(this.dataset.tagname, parseInt(this.dataset.tagtype), this)" class="text-gray-500 hover:text-red-400 hover:bg-red-500/20 focus:outline-none transition-colors mr-3 rounded-full ml-1" title="Unfollow">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>
      <% } else { %>
      <div class="bg-gray-700/30 rounded-lg p-8 text-center border border-gray-700 border-dashed">
        <svg class="w-16 h-16 text-gray-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path>
        </svg>
        <p class="text-gray-400">Belum ada tag yang diikuti.</p>
      </div>
      <% } %>
    </div>

    <!-- Script Configuration -->
    <div id="cytus-profile-config" 
      data-has-more="<%= (typeof totalSaves !== 'undefined' ? totalSaves : userProfile.saves.length) > 25 ? 'true' : 'false' %>"
      data-current-search="<%= typeof currentSearch !== 'undefined' ? currentSearch : '' %>"
      data-current-rating="<%= typeof currentRating !== 'undefined' ? currentRating : '' %>"
      style="display: none;">
    </div>
    <script src="/js/profile.js"></script>
</main>
</div>

<%- include('partials/modals/cropModal.ejs') %>
<%- include('partials/footer.ejs') %>