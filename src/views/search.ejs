<%
  const formatTags = (tagString, fallback = 'Original') => {
    if (!tagString || tagString.trim() === '') return fallback;
    const toTitleCase = (str) => str.replace(/\b\w/g, char => char.toUpperCase());

    const tags = tagString.split(' ');
    const formattedTags = tags.map(tag => {
      const spacedTag = tag.replace(/_/g, ' '); 
      return toTitleCase(spacedTag);
    });

    return formattedTags.join(', ');
  };
%>

<%- include('partials/header') %>

<main class="container mx-auto p-4">
  <% if (locals.invalidTag) { %>
    <div class="bg-gray-800/80 rounded-lg p-4 mb-6 shadow-lg backdrop-blur-sm">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-yellow-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <div class="flex-1">
          <h3 class="text-yellow-400 font-bold text-lg mb-1">Tag Tidak Ditemukan</h3>
          <p class="text-gray-300 text-sm mb-3">Tag <span class="font-mono text-cyan-400 bg-gray-900 px-1.5 py-0.5 rounded">"<%= locals.invalidTag %>"</span> tidak ada atau belum terdaftar. Saat ini sistem menampilkan hasil untuk tag terdekat: <span class="font-mono text-green-400 bg-gray-900 px-1.5 py-0.5 rounded">"<%= locals.userTags %>"</span>.</p>
          <% if (locals.smartSearchTags && locals.smartSearchTags.length > 1) { %>
            <details class="group mt-2">
              <summary class="text-xs text-cyan-400 mb-2 font-medium uppercase tracking-wider cursor-pointer flex items-center hover:text-cyan-300 transition-colors list-none [&::-webkit-details-marker]:hidden">
                <svg class="w-4 h-4 mr-1 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                Lihat <%= locals.smartSearchTags.length - 1 %> Rekomendasi Tag Lainnya
              </summary>
              <div class="mt-3 columns-2 sm:columns-3 md:columns-4 lg:columns-5 gap-2 space-y-2 pb-2 w-full overflow-hidden">
                <% locals.smartSearchTags.slice(1).forEach(suggestedTag => { %>
                  <a href="/search?tags=<%= encodeURIComponent(suggestedTag.name) %>" class="bg-gray-900 hover:bg-gray-700 border border-gray-600 px-2 py-1.5 rounded-md text-xs text-gray-300 transition-colors flex items-center justify-between gap-1 break-inside-avoid w-full overflow-hidden">
                    <span class="truncate min-w-0" title="<%= suggestedTag.name %>"><%= suggestedTag.name %></span>
                    <span class="text-gray-500 text-[10px] bg-gray-800 px-1.5 py-0.5 rounded shrink-0"><%= suggestedTag.post_count.toLocaleString('en-US') %></span>
                  </a>
                <% }) %>
              </div>
            </details>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <% if (sliderPosts.length > 0) { %>
  <h2 class="text-2xl font-bold mb-4 text-white text-start"><%= userTags ? 'Top Contents' : 'Contents of the Month' %></h2>
  <div class="swiper mb-12">
    <div class="swiper-wrapper">
      <% let validSliderIndex = 0; %>
      <% sliderPosts.forEach((post, index) => { %>
      <% if(post.large_file_url) { %>
      <% const isSaved = locals.savedPostIds ? savedPostIds.has(post.id.toString()) : false; %>
      <% const isVideo = post.large_file_url.endsWith('.mp4') || post.large_file_url.endsWith('.webm'); %>
      <% const previewUrl = isVideo ? (post.media_asset?.variants.find(v => v.type === '720x720')?.url || post.media_asset?.variants.find(v => v.type === '360x360')?.url || post.preview_file_url) : ''; %>
      <div class="swiper-slide group gallery-item relative z-0 bg-gray-800 rounded-lg overflow-hidden group-hover:z-10 <%= isSaved ? 'border-4 border-yellow-500' : '' %>" data-post-url="/posts/<%= post.id %>" data-is-video="<%= isVideo %>" data-video-url="<%= isVideo ? post.large_file_url : '' %>" data-preview-url="<%= previewUrl %>">
        
        <div class="absolute top-0 left-0 z-20 bg-black/50 text-white text-xs px-2 py-1 rounded-br-md pointer-events-none transition-opacity duration-300 group-hover:opacity-0">
          <%= validSliderIndex + 1 %>
        </div>

        <div class="absolute top-0 right-0 z-20 flex pointer-events-none transition-opacity duration-300 group-hover:opacity-0">
          <% if ((post.file_ext === 'mp4' || post.file_ext === 'webm') && post.media_asset && post.media_asset.duration) { %>
            <% 
              const durationSec = Math.floor(post.media_asset.duration);
              const m = Math.floor(durationSec / 60).toString().padStart(2, '0');
              const s = (durationSec % 60).toString().padStart(2, '0');
            %>
            <span class="bg-gray-800/80 text-white text-[10px] font-bold px-2 py-1 shadow-sm"><%= m %>:<%= s %></span>
          <% } %>
          <span class="bg-blue-600 text-white text-[10px] font-bold px-2 py-1 rounded-bl-md shadow-sm"><%= post.file_ext.toUpperCase() %></span><% if (post.rating) { %><% 
            let ratingColor = '';
            switch (post.rating) {
                case 'g': ratingColor = 'bg-green-600'; break;
                case 's': ratingColor = 'bg-yellow-600'; break;
                case 'q': ratingColor = 'bg-purple-600'; break;
                case 'e': ratingColor = 'bg-red-600'; break;
            }
          %><span class="<%= ratingColor %> text-white text-[10px] font-bold px-2 py-1 shadow-sm"><%= post.rating.toUpperCase() %></span><% } %>
        </div>

        <div class="media-container relative w-full h-auto aspect-video bg-black">
          <% if (post.large_file_url.endsWith('.mp4') || post.large_file_url.endsWith('.webm')) { %>
          <img src="<%= post.media_asset?.variants.find(v => v.type === '720x720')?.url || post.media_asset?.variants.find(v => v.type === '360x360')?.url || post.preview_file_url %>" alt="Video preview" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
          <video class="video-playback hidden absolute inset-0 w-full h-full object-cover" preload="none" loop muted playsinline></video>
          <% } else { %>
          <img src="<%= post.large_file_url %>" alt="Konten oleh: <%= post.tag_string_artist %>" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="<%= isLazyLoadEnabled ? 'lazy' : 'eager' %>">
          <% } %>
        </div>

        <div class="overlay absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-3 flex flex-col justify-end text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none group-hover:pointer-events-auto">
          <div class="overlay-content">
            <h4 class="font-bold truncate"><%= formatTags(post.tag_string_character, 'Unknown Character') %></h4>
            <p class="text-sm truncate"><%= formatTags(post.tag_string_copyright, 'Original') %></p>
              <div class="flex gap-2 mt-2">
                <a href="/posts/<%= post.id %>" class="detail-button flex-grow text-center bg-cyan-600 text-xs py-1.5 rounded-md hover:bg-cyan-700 transition-colors font-bold">Lihat Detail</a>
                <% if (locals.user) { %>
                <button onclick="savePostOverlay(event, '<%= post.id %>', this)" class="<%= isSaved ? 'bg-green-600 hover:bg-green-700' : 'bg-gray-700 hover:bg-gray-600' %> text-white px-3 py-1.5 rounded-md transition-colors flex items-center justify-center shadow-sm" title="Simpan ke Koleksi">
                  <% if (isSaved) { %>
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                  <% } else { %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                  <% } %>
                </button>
                <% } %>
              </div>
          </div>
        </div>
      </div>
      <% validSliderIndex++; %>
      <% } %>
      <% }); %>
    </div>
    <div class="swiper-button-next text-white"></div>
    <div class="swiper-button-prev text-white"></div>
  </div>
  <% } %>


  <h2 class="text-2xl font-bold mb-4 text-white text-start flex items-center gap-2">
    Contents 
    <% if (locals.totalPosts && locals.totalPosts > 0) { %>
      <span class="text-gray-400 text-lg font-normal">(<%= Number(locals.totalPosts).toLocaleString('en-US') %>)</span>
    <% } %>
  </h2>
  <div id="main-gallery" class="columns-2 md:columns-5 gap-4 space-y-4">

    <%# Cek apakah ada postingan untuk ditampilkan %>
    <% if (posts && posts.length > 0) { %>
    <% let validIndex = 0; %>
    <% posts.forEach((post, index) => { %>
    <% if (post.large_file_url) { %>
    <% const isSaved = locals.savedPostIds ? savedPostIds.has(post.id.toString()) : false; %>
    <% const isVideo = post.large_file_url.endsWith('.mp4') || post.large_file_url.endsWith('.webm'); %>
    <% const previewUrl = isVideo ? (post.media_asset?.variants.find(v => v.type === '720x720')?.url || post.media_asset?.variants.find(v => v.type === '360x360')?.url || post.preview_file_url) : ''; %>
    <div class="group gallery-item relative z-0 break-inside-avoid bg-gray-800 rounded-md overflow-hidden <%= isSaved ? 'border-4 border-yellow-500' : '' %>" data-post-url="/posts/<%= post.id %>" data-is-video="<%= isVideo %>" data-video-url="<%= isVideo ? post.large_file_url : '' %>" data-preview-url="<%= previewUrl %>">
      <div class="absolute top-0 left-0 z-20 bg-black/50 text-white text-xs px-2 py-1 rounded-br-md pointer-events-none transition-opacity duration-300 group-hover:opacity-0">
        <%= ((currentPage - 1) * limit) + validIndex + 1 %>
      </div>

      <div class="absolute top-0 right-0 z-20 flex items-start pointer-events-none transition-opacity duration-300 group-hover:opacity-0 drop-shadow-md">
        <% if ((post.file_ext === 'mp4' || post.file_ext === 'webm') && post.media_asset && post.media_asset.duration) { %>
          <% 
            const durationSec = Math.floor(post.media_asset.duration);
            const m = Math.floor(durationSec / 60).toString().padStart(2, '0');
            const s = (durationSec % 60).toString().padStart(2, '0');
          %>
          <span class="bg-gray-800/80 text-white text-[10px] font-bold px-2 py-1 shadow-sm"><%= m %>:<%= s %></span>
        <% } %>
        <span class="bg-blue-600 text-white text-[10px] font-bold px-2 py-1 rounded-bl-md"><%= post.file_ext.toUpperCase() %></span>
        <% let rc; if(post.rating==='g')rc='bg-green-600'; if(post.rating==='s')rc='bg-yellow-600'; if(post.rating==='q')rc='bg-purple-600'; if(post.rating==='e')rc='bg-red-600'; %>
        <% if (post.rating) { %>
        <span class="<%= rc %> text-white text-[10px] font-bold px-2 py-1"><%= post.rating.toUpperCase() %></span>
        <% } %>
      </div>

      <% const styleAttr2 = `style="aspect-ratio: ${post.image_width || 1}/${post.image_height || 1};"`; %>
      <div class="media-container w-full h-auto" <%- styleAttr2 %>>
        <% if (post.large_file_url.endsWith('.mp4') || post.large_file_url.endsWith('.webm')) { %>
        <img src="<%= post.media_asset?.variants.find(v => v.type === '720x720')?.url || post.media_asset?.variants.find(v => v.type === '360x360')?.url || post.preview_file_url %>" alt="Video preview" class="video-preview w-full h-auto transition-transform duration-300 group-hover:scale-105">
        <video class="video-playback hidden w-full h-auto" preload="none" loop muted playsinline></video>
        <% } else { %>
        <img src="<%= post.media_asset?.variants.find(v => v.type === '720x720')?.url || post.media_asset?.variants.find(v => v.type === '360x360')?.url || post.large_file_url %>" alt="Konten oleh: <%= post.tag_string_artist %>" class="w-full h-auto transition-transform duration-300 group-hover:scale-105" loading="<%= isLazyLoadEnabled ? 'lazy' : 'eager' %>">
        <% } %>
      </div>

      <div class="overlay absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-3 flex flex-col justify-end text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none group-hover:pointer-events-auto">
        <div class="overlay-content">
          <h4 class="font-bold truncate text-sm md:text-base"><%= formatTags(post.tag_string_character, 'Unknown Character') %></h4>
          <p class="text-xs md:text-sm truncate text-gray-300"><%= formatTags(post.tag_string_copyright, 'Original') %></p>

          <div class="flex gap-2 mt-2">
            <a href="/posts/<%= post.id %>" class="detail-button flex-grow text-center bg-cyan-600 text-xs py-1.5 rounded-md hover:bg-cyan-700 transition-colors font-bold">Lihat Detail</a>
            <% if (locals.user) { %>
            <button onclick="savePostOverlay(event, '<%= post.id %>', this)" class="<%= isSaved ? 'bg-green-600 hover:bg-green-700' : 'bg-gray-700 hover:bg-gray-600' %> text-white px-3 py-1.5 rounded-md transition-colors flex items-center justify-center shadow-sm" title="Simpan ke Koleksi">
              <% if (isSaved) { %>
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
              <% } else { %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
              <% } %>
            </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <% validIndex++; %>
    <% } %>
    <% }); %>
    
    <% if (validIndex > 0 && validIndex < limit) { %>
      <div class="col-span-2 md:col-span-5 bg-gray-800/80 border border-gray-700 text-gray-400 p-4 rounded-md text-center text-sm mt-4 shadow-sm">
        <span class="text-yellow-500 font-semibold"><%= limit - validIndex %> konten disembunyikan</span> secara otomatis oleh sistem Danbooru (dihapus, di-banned, atau dibatasi untuk API publik). 
      </div>
    <% } %>
    
    <% } else { %>

    <div class="w-full flex flex-col items-center justify-center py-24 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 text-gray-700 mb-4 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <h3 class="text-2xl font-semibold text-white">Tidak Ada Hasil Ditemukan</h3>
      <p class="text-gray-400 mt-2 max-w-sm mx-auto">
        Tidak ada konten yang cocok untuk "<%= userTags.replace(/_/g, ' ') %>". Coba gunakan kata kunci atau kombinasi filter yang berbeda.
      </p>
    </div>

    <% } %>

  </div>
</main>

<%- include('partials/pagination', { currentPage, totalPages, limit, tagsForPagination: tagsForPagination }) %>
<% if (popularTags.length > 0 || popularCharacters.length > 0) { %>
<div class="py-8 bg-black/30">
  <div class="container mx-auto mt-12">

    <% if (popularTags.length > 0) { %>
    <section class="bg-gray-900/50 rounded-lg p-4">
      <h2 class="text-2xl font-bold mb-4 text-white text-start">Popular Series</h2>
      <div class="relative overflow-hidden" style="mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);">
        <div class="marquee-container flex">
          <div class="marquee-content flex-shrink-0 flex items-center justify-start min-w-full">
            <% popularTags.forEach(tag => { %>
            <a href="/search?tags=<%= tag.name %>" class="bg-gray-700 hover:bg-gray-600 text-base px-4 py-2 rounded-md mx-4 whitespace-nowrap tag-link"><%= tag.name.replace(/_/g, ' ') %></a>
            <% }); %>
          </div>
          <div class="marquee-content flex-shrink-0 flex items-center justify-start min-w-full">
            <% popularTags.forEach(tag => { %>
            <a href="/search?tags=<%= tag.name %>" class="bg-gray-700 hover:bg-gray-600 text-base px-4 py-2 rounded-md mx-4 whitespace-nowrap tag-link"><%= tag.name.replace(/_/g, ' ') %></a>
            <% }); %>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <% if (popularCharacters.length > 0) { %>
    <section class="mt-6 bg-gray-900/50 rounded-lg p-4">
      <h2 class="text-2xl font-bold mb-4 text-white text-start">Popular Characters</h2>
      <div class="relative overflow-hidden" style="mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);">
        <div class="marquee-container-reverse flex">
          <div class="marquee-content-reverse flex-shrink-0 flex items-center justify-start min-w-full">
            <% popularCharacters.forEach(tag => { %>
            <a href="/search?tags=<%= tag.name %>" class="bg-gray-700 hover:bg-gray-600 text-base px-4 py-2 rounded-md mx-4 whitespace-nowrap tag-link"><%= tag.name.replace(/_/g, ' ') %></a>
            <% }); %>
          </div>
          <div class="marquee-content-reverse flex-shrink-0 flex items-center justify-start min-w-full">
            <% popularCharacters.forEach(tag => { %>
            <a href="/search?tags=<%= tag.name %>" class="bg-gray-700 hover:bg-gray-600 text-base px-4 py-2 rounded-md mx-4 whitespace-nowrap tag-link"><%= tag.name.replace(/_/g, ' ') %></a>
            <% }); %>
          </div>
        </div>
      </div>
    </section>
    <% } %>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>