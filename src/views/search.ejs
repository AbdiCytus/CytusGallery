                     <label class="text-[11px] text-cyan-400 mb-1 block">Tanggal</label>
                     <input type="number" id="range-end-day" disabled placeholder="DD" class="w-full bg-gray-800 border border-gray-700 rounded-md p-1.5 text-white text-sm focus:border-cyan-500 outline-none opacity-50 cursor-not-allowed disabled:bg-gray-800" min="1" max="31">
