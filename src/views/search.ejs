    <!-- FOOTER -->
    <div class="p-4 bg-gray-900 border-t border-gray-800 flex justify-between gap-3 shrink-0">
      <button onclick="resetFollowedTagsFilter()" class="flex-1 md:flex-none px-5 py-2.5 text-sm font-medium text-gray-300 hover:text-white transition-colors bg-gray-800 border border-gray-700 md:border-transparent md:bg-gray-800 hover:bg-gray-700 rounded-lg md:rounded-md">
        <span class="hidden md:inline">Reset Semua Filter</span><span class="md:hidden">Reset</span>
      </button>
      <button onclick="applyFollowedTagsFilter()" class="flex-1 md:flex-none px-6 py-2.5 text-sm font-bold text-white bg-cyan-600 hover:bg-cyan-500 rounded-lg md:rounded-md shadow-md shadow-cyan-900/20 transition-colors">
        <span class="hidden md:inline">Terapkan Filter</span><span class="md:hidden">Filter</span>
      </button>
