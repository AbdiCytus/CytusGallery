<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Menghubungkan ke Orbit Station - CytusGallery</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      background-color: #0f172a; /* slate-900 */
      color: white;
      margin: 0;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
    }
    .space-bg {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: radial-gradient(circle at center, #1e293b 0%, #020617 100%);
      z-index: -2;
    }
    
    /* Orbit Path */
    .orbit-path {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 300px;
      height: 300px;
      border: 1px dashed rgba(6, 182, 212, 0.3); /* cyan-500 */
      border-radius: 50%;
      z-index: -1;
      animation: spin 10s linear infinite;
    }
    
    .orbit-path-2 {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      height: 450px;
      border: 1px dashed rgba(168, 85, 247, 0.2); /* purple-500 */
      border-radius: 50%;
      z-index: -1;
      animation: spin-reverse 15s linear infinite;
    }

    /* Satellite / Data Packet */
    .satellite {
      position: absolute;
      top: -6px; left: 50%;
      transform: translateX(-50%);
      width: 12px;
      height: 12px;
      background-color: #22d3ee; /* cyan-400 */
      border-radius: 50%;
      box-shadow: 0 0 15px 5px rgba(34, 211, 238, 0.6);
    }
    
    .satellite-2 {
      position: absolute;
      top: 50%; left: -6px;
      transform: translateY(-50%);
      width: 10px;
      height: 10px;
      background-color: #c084fc; /* purple-400 */
      border-radius: 50%;
      box-shadow: 0 0 15px 5px rgba(192, 132, 252, 0.5);
    }

    /* Center Hubs */
    .hub-container {
      position: relative;
      width: 100px;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }
    
    .hub {
      width: 80px;
      height: 80px;
      background-color: #1e293b; /* slate-800 */
      border: 2px solid #334155; /* slate-700 */
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5);
      position: relative;
      overflow: hidden;
      z-index: 2;
    }
    
    .hub img {
      width: 45px;
      height: 45px;
      object-fit: contain;
      z-index: 2;
      animation: pulse 2s ease-in-out infinite;
    }

    /* Connecting Beam */
    .beam {
      position: absolute;
      top: 50%; left: 50%;
      transform: translateY(-50%);
      height: 4px;
      width: 0;
      background: linear-gradient(90deg, #c084fc, #22d3ee);
      box-shadow: 0 0 10px 2px rgba(34, 211, 238, 0.5);
      z-index: 1;
      border-radius: 4px;
      animation: shoot-beam 1.5s ease-out forwards;
      animation-delay: 0.5s;
    }

    /* Glow Behind Hub */
    .hub-glow {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 20px;
      background: #22d3ee;
      filter: blur(20px);
      opacity: 0;
      z-index: 1;
      animation: fade-glow 2s ease-in-out infinite alternate;
    }
    
    .hub-glow-orbit {
      background: #c084fc;
    }

    @keyframes spin { 100% { transform: translate(-50%, -50%) rotate(360deg); } }
    @keyframes spin-reverse { 100% { transform: translate(-50%, -50%) rotate(-360deg); } }
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }
    @keyframes fade-glow {
      0% { opacity: 0.2; }
      100% { opacity: 0.6; }
    }
    @keyframes shoot-beam {
      0% { width: 0; opacity: 1; }
      70% { width: 140px; opacity: 1; }
      100% { width: 140px; opacity: 0; }
    }
    
    .status-text {
      animation: typing 2s steps(40, end), blink-caret .75s step-end infinite;
      white-space: nowrap;
      overflow: hidden;
      border-right: 3px solid #22d3ee;
    }
    
    @keyframes typing {
      from { width: 0 }
      to { width: 100% }
    }
    @keyframes blink-caret {
      from, to { border-color: transparent }
      50% { border-color: #22d3ee; }
    }
  </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen relative">
  <div class="space-bg"></div>
  
  <div class="relative w-full max-w-lg flex flex-col items-center justify-center">
    
    <!-- Orbits -->
    <div class="orbit-path"><div class="satellite"></div></div>
    <div class="orbit-path-2"><div class="satellite-2"></div></div>
    
    <!-- Stations Connection -->
    <div class="flex items-center justify-center gap-12 relative w-full mb-12">
      <!-- Orbit Station Hub -->
      <div class="hub-container">
        <div class="hub-glow hub-glow-orbit"></div>
        <div class="hub">
          <img src="/orbit_station.png" alt="Orbit Station">
        </div>
      </div>
      
      <!-- Energy Beam -->
      <div class="beam"></div>
      
      <!-- CytusGallery Hub -->
      <div class="hub-container">
        <div class="hub-glow"></div>
        <div class="hub">
          <img src="/logo.png" alt="CytusGallery">
        </div>
      </div>
    </div>
    
    <!-- Status Text -->
    <div class="text-center mt-8 z-10">
      <h2 class="text-2xl font-bold text-white mb-2">Sinkronisasi Orbit Station</h2>
      <div class="inline-block">
        <p class="text-cyan-400 font-mono text-sm status-text">Otentikasi berhasil. Memuat modul CytusGallery...</p>
      </div>
    </div>
  </div>

  <script>
    // Redirect after animation completes
    setTimeout(() => {
      window.location.href = '/';
    }, 2800);
  </script>
</body>
</html>
