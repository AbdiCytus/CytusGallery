<%- include('partials/header', { tags: '' }) %>

<main id="main-content" class="container mx-auto p-4">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

    <div class="md:col-span-2 bg-gray-800 rounded-lg p-2 flex flex-col justify-center items-center">
      <% if (post.file_ext === 'mp4' || post.file_ext === 'webm' || post.file_ext === "zip") { %>
      <video src="<%= post.large_file_url %>" class="max-w-full max-h-[90vh] rounded-md" controls autoplay loop muted></video>
      <% } else { %>
      <img src="<%= post.large_file_url %>" alt="Detail konten" class="max-w-full max-h-[90vh] rounded-md">
      <% } %>
      <!-- Mobile Download Progress Bar -->
      <div id="mobile-dl-container" class="w-full mt-4 hidden md:hidden px-2">
        <div class="flex justify-between text-xs text-gray-400 mb-1 font-semibold">
          <span id="mobile-dl-text">Mengunduh...</span>
          <span id="mobile-dl-percent">0%</span>
        </div>
        <div class="w-full bg-gray-700 rounded-full h-2.5 overflow-hidden">
          <div id="mobile-dl-bar" class="bg-cyan-500 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <div class="md:col-span-1">
      <h2 class="text-2xl font-bold mb-4">Informasi & Tag</h2>
      <div class="space-y-4">

        <div>
          <h3 class="font-semibold mb-2 text-gray-400">Metadata</h3>
          <div class="flex flex-wrap gap-2 text-sm">
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>ID:</strong> <%= post.id %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Rating:</strong> <%= post.rating.toUpperCase() %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Score:</strong> <%= post.score %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Size:</strong> <%= (post.file_size / 1024 / 1024).toFixed(2) %> MB</span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Dimensions:</strong> <%= post.image_width %>x<%= post.image_height %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Uploaded:</strong> <%= new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
            <% if (post.source) { %>
            <a href="<%= post.source %>" target="_blank" rel="noopener noreferrer" class="bg-gray-700 hover:bg-gray-600 px-2 py-1 rounded-md flex items-center gap-1">
              <strong>Source</strong>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            </a>
            <% } %>
          </div>
        </div>

        <% const renderTags = (title, tagString, colorClass, tagType, collapsible = false) => {
            if (tagString && tagString.trim() !== '') {
                  const tags = tagString.split(' ');%>
        <div class="<%= collapsible ? 'mt-4' : '' %>">
          <div class="flex justify-between items-center <%= collapsible ? 'cursor-pointer collapse-trigger' : '' %>">
            <h3 class="font-semibold mb-2 <%= colorClass %>"><%= title %> <%= collapsible ? `(${tags.length})` : '' %></h3>
            <% if (collapsible) { %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 transition-transform duration-300 transform collapse-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            <% } %>
          </div>
          <div class="flex flex-wrap gap-2 <%= collapsible ? 'hidden mt-2 collapse-content' : '' %>">
            <% tags.forEach(tag => { 
                 const isFollowed = locals.followedTags && locals.followedTags.includes(tag);
            %>
            <div class="flex items-stretch bg-gray-700 hover:bg-gray-600 rounded-md overflow-hidden border border-gray-600">
              <a href="/search?tags=<%= tag %>" class="tag-link text-sm px-2 py-1 flex items-center">
                <%= tag.replace(/_/g, ' ') %>
              </a>
              <% if (locals.user && tagType) { %>
                <button data-tag="<%= tag %>" data-type="<%= tagType %>" class="follow-btn px-2 flex items-center border-l border-gray-600 <%= isFollowed ? 'bg-cyan-600 text-white hover:bg-cyan-700' : 'text-gray-400 hover:bg-gray-500 hover:text-white' %> transition-colors" title="<%= isFollowed ? 'Unfollow' : 'Follow' %>">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 follow-icon <%= isFollowed ? 'hidden' : 'block' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 followed-icon <%= isFollowed ? 'block' : 'hidden' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>
              <% } %>
            </div>
            <% }); %>
          </div>
        </div>
        <%
            }
          }
        %>
        <% renderTags('Copyright', post.tag_string_copyright, 'text-purple-400', 3); %>
        <% renderTags('Character(s)', post.tag_string_character, 'text-green-400', 4); %>
        <% renderTags('Artist', post.tag_string_artist, 'text-red-400', 1); %>
        <% renderTags('Meta Tags', post.tag_string_meta, 'text-yellow-400', null); %>
        <% renderTags('General Tags', post.tag_string_general, 'text-blue-400', null, true); %>

        <div class="pt-4 flex flex-col gap-3">
          <div class="flex gap-3">
            <% if (locals.user) { %>
              <button id="save-button" class="flex-1 <%= isSaved ? 'bg-green-600 hover:bg-green-700' : 'bg-yellow-600 hover:bg-yellow-700' %> text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Simpan Konten">
                <svg class="w-5 h-5 flex-shrink-0" fill="<%= isSaved ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <span id="save-button-text" class="truncate text-base"><%= isSaved ? 'Tersimpan' : 'Simpan' %></span>
              </button>
            <% } %>
            <button id="download-button" class="flex-1 bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Download Original">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
              <span class="truncate text-base">Download</span>
            </button>
          </div>
          <div class="flex gap-3">
            <a href="<%= post.large_file_url %>" target="_blank" rel="noopener noreferrer" class="flex-1 bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Lihat Gambar Penuh">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
              <span class="truncate text-base">Lihat Penuh</span>
            </a>
            <button id="share-button" class="flex-1 bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Salin Link">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
              <span class="truncate text-base">Salin Link</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<div id="success-modal" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
  <div id="success-modal-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

  <div class="relative rounded-lg p-4 bg-gray-800 border border-gray-700 shadow-2xl w-11/12 max-w-sm transform scale-95 transition-transform duration-300 text-center">

    <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-900/30 mb-2 ring-1 ring-green-500/50">
      <svg class="h-10 w-10 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <h3 class="text-2xl font-bold text-white tracking-wide">Berhasil!</h3>

    <div class="mt-3">
      <p class="text-sm text-gray-400 leading-relaxed">
        Link tautan telah berhasil disalin ke clipboard.
      </p>
    </div>

    <div class="mt-3 flex justify-center">
      <button id="close-modal-btn" type="button" class=" rounded inline-flex w-full py-1 justify-center shadow-lg shadow-cyan-900/20 bg-cyan-600 text-sm font-bold text-white hover:bg-cyan-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-cyan-500 transition-colors duration-200">
        OK
      </button>
    </div>
  </div>
</div>

<main id="error-content" class="hidden container mx-auto mt-12 p-2 min-h-[70vh] flex items-center justify-center text-white">
  <div class="text-center flex flex-col items-center bg-gray-800 p-8 rounded-lg shadow-2xl border border-gray-700">
    <h1 class="text-3xl font-bold pt-4 mb-2 text-white">Konten Tidak Ditemukan</h1>
    <p id="error-message" class="text-gray-400 mt-4 mb-6 max-w-md"></p>
    <a href="/" class="bg-cyan-600 hover:bg-cyan-500 text-white font-bold py-2 px-6 rounded-lg transition-colors shadow-lg shadow-cyan-500/30">Kembali ke Beranda</a>
  </div>
</main>



<div id="cytus-detail-config"
  data-rating="<%= typeof post !== 'undefined' ? post.rating : '' %>"
  data-bypass="<%= typeof locals !== 'undefined' && locals.isBypass ? 'true' : 'false' %>"
  data-fileurl="<%= typeof post !== 'undefined' ? post.file_url : '' %>"
  data-filename="<%= typeof post !== 'undefined' ? (post.md5 + '.' + post.file_ext) : '' %>"
  data-postid="<%= typeof post !== 'undefined' ? post.id : '' %>"
  style="display: none;"></div>
<script src="/js/detail.js?v=2"></script>

<%- include('partials/footer') %>