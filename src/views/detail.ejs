<div id="cytus-detail-config"
  data-rating="<%= typeof post !== 'undefined' ? post.rating : '' %>"
  data-bypass="<%= typeof locals !== 'undefined' && locals.isBypass ? 'true' : 'false' %>"
  data-fileurl="<%= typeof post !== 'undefined' ? post.file_url : '' %>"
  data-filename="<%= typeof post !== 'undefined' ? (post.md5 + '.' + post.file_ext) : '' %>"
  data-postid="<%= typeof post !== 'undefined' ? post.id : '' %>"
  style="display: none;"></div>
<script src="/js/detail.js?v=2"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.local-time').forEach(el => {
      const ts = el.getAttribute('data-timestamp');
      if (ts) {
        const d = new Date(ts);
        if (!isNaN(d)) {
          el.textContent = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        }
      }
    });
    const mainContent = document.getElementById('main-content');
    const leftPanel = document.getElementById('left-panel');
    const rightPanel = document.getElementById('right-panel');
    const toggleBtn = document.getElementById('toggle-related-btn');
    const toggleIcon = document.getElementById('toggle-icon');
    
    let isCollapsed = false;

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        if (toggleBtn.disabled) return;
        
        const performToggle = () => {
          isCollapsed = !isCollapsed;
          
          if (isCollapsed) {
            mainContent.classList.add('md:gap-0');
            leftPanel.classList.remove('md:w-3/5', 'lg:w-2/3', 'md:opacity-100');
            leftPanel.classList.add('md:w-0', 'md:opacity-0', 'pointer-events-none');
            rightPanel.classList.remove('md:w-2/5', 'lg:w-1/3', 'md:sticky', 'md:top-24', 'md:h-[calc(100vh-7rem)]', 'md:overflow-y-auto');
            rightPanel.classList.add('md:w-full', 'lg:w-full');
            
            const detailHeader = document.getElementById('detail-header');
            const detailTitle = document.getElementById('detail-title');
            if (detailHeader && detailTitle) {
              detailTitle.style.display = 'none';
              detailHeader.classList.remove('border-b', 'border-gray-700', 'pb-2', 'justify-between');
              detailHeader.classList.add('justify-end', 'pb-0');
            }

            const rightInner = document.getElementById('right-panel-inner');
            const leftCol = document.getElementById('detail-left-column');
            const infoContainer = document.getElementById('detail-info-container');
            if (rightInner && leftCol && infoContainer) {
              rightInner.classList.add('md:grid', 'md:grid-cols-3', 'md:gap-8');
              leftCol.classList.add('md:col-span-2');
              infoContainer.classList.add('md:col-span-1');
            }
            
            toggleIcon.style.transform = 'rotate(180deg)';
          } else {
            mainContent.classList.remove('md:gap-0');
            leftPanel.classList.remove('md:w-0', 'md:opacity-0', 'pointer-events-none');
            leftPanel.classList.add('md:w-3/5', 'lg:w-2/3', 'md:opacity-100');
            rightPanel.classList.remove('md:w-full', 'lg:w-full');
            rightPanel.classList.add('md:w-2/5', 'lg:w-1/3', 'md:sticky', 'md:top-24', 'md:h-[calc(100vh-7rem)]', 'md:overflow-y-auto');
            
            const detailHeader = document.getElementById('detail-header');
            const detailTitle = document.getElementById('detail-title');
            if (detailHeader && detailTitle) {
              detailTitle.style.display = 'block';
              detailHeader.classList.add('border-b', 'border-gray-700', 'pb-2', 'justify-between');
              detailHeader.classList.remove('justify-end', 'pb-0');
            }

            const rightInner = document.getElementById('right-panel-inner');
            const leftCol = document.getElementById('detail-left-column');
            const infoContainer = document.getElementById('detail-info-container');
            if (rightInner && leftCol && infoContainer) {
              rightInner.classList.remove('md:grid', 'md:grid-cols-3', 'md:gap-8');
              leftCol.classList.remove('md:col-span-2');
              infoContainer.classList.remove('md:col-span-1');
            }

            toggleIcon.style.transform = 'rotate(0deg)';
          }
          
          toggleBtn.disabled = false;
        };

        if (window.scrollY === 0) {
          performToggle();
        } else {
          toggleBtn.disabled = true;
          window.scrollTo({ top: 0, behavior: 'smooth' });
          
          let isDone = false;
          const onDone = () => {
            if (isDone) return;
            isDone = true;
            window.removeEventListener('scrollend', onDone);
            performToggle();
          };
          
          window.addEventListener('scrollend', onDone);
          // Fallback timeout untuk browser lama
          setTimeout(onDone, 600);
        }
      });
    }
    // Fallback scroll dari Kiri (window) ke Kanan (right-panel)
    window.addEventListener('wheel', (e) => {
      const rightPanel = document.getElementById('right-panel');
      if (!rightPanel) return;
      
      // Hanya aktif jika layout desktop (ada overflow-y-auto) & tidak sedang di-collapse
      const isDesktopSplit = window.getComputedStyle(rightPanel).overflowY === 'auto' && !rightPanel.classList.contains('md:w-full');
      if (!isDesktopSplit) return;

      const mainContentObj = document.getElementById('main-content');
      if (!mainContentObj) return;

      const atTop = window.scrollY <= 0;
      
      // Cek apakah bagian bawah dari konten utama (termasuk related content) sudah mencapai dasar layar
      // Ini berarti pengguna sudah mentok me-scroll seluruh grid related content dan footer akan mulai terlihat
      const mainBottom = mainContentObj.getBoundingClientRect().bottom;
      const reachingFooter = mainBottom <= window.innerHeight + 2;

      if (atTop && e.deltaY < 0) {
        if (rightPanel.scrollTop > 0) {
          rightPanel.scrollTop += e.deltaY;
          e.preventDefault();
        }
      } else if (reachingFooter && e.deltaY > 0) {
        // Hanya oper ke panel kanan JIKA related content sudah selesai dimuat sepenuhnya (sampai mentok)
        const relatedLoader = document.getElementById('related-loader');
        const isRelatedDone = !relatedLoader || relatedLoader.classList.contains('hidden');
        
        if (isRelatedDone) {
          const rpAtBottom = Math.ceil(rightPanel.clientHeight + rightPanel.scrollTop) >= rightPanel.scrollHeight - 1;
          if (!rpAtBottom) {
            // Tahan window agar tidak scroll lebih jauh (menyembunyikan footer) dan oper ke kanan
            rightPanel.scrollTop += e.deltaY;
            e.preventDefault();
          }
        }
      }
    }, { passive: false });
    // === Notes Overlay ===
    const toggleNotesBtn = document.getElementById('toggle-notes-btn');
    const notesOverlay = document.getElementById('notes-overlay');
    const mainImage = document.getElementById('detail-main-image');
    let notesVisible = false;

    function positionNotes() {
      if (!mainImage || !notesOverlay) return;
      const boxes = notesOverlay.querySelectorAll('.note-box');
      const origW = parseInt(mainImage.dataset.originalWidth) || mainImage.naturalWidth;
      const origH = parseInt(mainImage.dataset.originalHeight) || mainImage.naturalHeight;
      const rendW = mainImage.clientWidth;
      const rendH = mainImage.clientHeight;
      if (!origW || !origH || !rendW || !rendH) return;
      const scaleX = rendW / origW;
      const scaleY = rendH / origH;
      boxes.forEach(box => {
        const x = parseFloat(box.dataset.x);
        const y = parseFloat(box.dataset.y);
        const w = parseFloat(box.dataset.w);
        const h = parseFloat(box.dataset.h);
        box.style.left = (x * scaleX) + 'px';
        box.style.top = (y * scaleY) + 'px';
        box.style.width = (w * scaleX) + 'px';
        box.style.height = (h * scaleY) + 'px';
      });
    }

    if (toggleNotesBtn && notesOverlay) {
      toggleNotesBtn.addEventListener('click', () => {
        notesVisible = !notesVisible;
        if (notesVisible) {
          notesOverlay.classList.remove('hidden');
          notesOverlay.querySelectorAll('.note-box').forEach(b => b.classList.replace('opacity-0', 'opacity-100'));
          toggleNotesBtn.classList.add('bg-cyan-600', 'hover:bg-cyan-700');
          toggleNotesBtn.classList.remove('bg-black/60', 'hover:bg-black/80');
          positionNotes();
        } else {
          notesOverlay.classList.add('hidden');
          notesOverlay.querySelectorAll('.note-box').forEach(b => b.classList.replace('opacity-100', 'opacity-0'));
          toggleNotesBtn.classList.remove('bg-cyan-600', 'hover:bg-cyan-700');
          toggleNotesBtn.classList.add('bg-black/60', 'hover:bg-black/80');
        }
      });
      if (mainImage) {
        mainImage.addEventListener('load', positionNotes);
        window.addEventListener('resize', positionNotes);
      }
    }

    // Note hover tooltip
    document.querySelectorAll('.note-box').forEach(box => {
      const tooltip = box.querySelector('.note-tooltip');
      if (!tooltip) return;
      box.addEventListener('mouseenter', () => tooltip.classList.remove('hidden'));
      box.addEventListener('mouseleave', () => tooltip.classList.add('hidden'));
      box.addEventListener('click', () => tooltip.classList.toggle('hidden'));
    });

    // === Artist Commentary Toggle ===
    window.toggleCommentary = function(mode) {
      const translated = document.getElementById('commentary-translated');
      const original = document.getElementById('commentary-original');
      const translatedBtn = document.getElementById('commentary-translated-btn');
      const originalBtn = document.getElementById('commentary-original-btn');
      const title = document.getElementById('commentary-title');
      if (!translated || !original) return;
      if (mode === 'original') {
        translated.classList.add('hidden');
        original.classList.remove('hidden');
        if (translatedBtn) { translatedBtn.classList.remove('bg-pink-700', 'text-white'); translatedBtn.classList.add('text-gray-400'); }
        if (originalBtn) { originalBtn.classList.add('bg-pink-700', 'text-white'); originalBtn.classList.remove('text-gray-400'); }
      } else {
        original.classList.add('hidden');
        translated.classList.remove('hidden');
        if (translatedBtn) { translatedBtn.classList.add('bg-pink-700', 'text-white'); translatedBtn.classList.remove('text-gray-400'); }
        if (originalBtn) { originalBtn.classList.remove('bg-pink-700', 'text-white'); originalBtn.classList.add('text-gray-400'); }
      }
    };
  });
</script>

