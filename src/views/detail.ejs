<%
  const getDisplayTags = (post) => {
    const toTitleCase = (str) => {
      if (!str || str.trim() === '') return '';
      return str.split(' ').map(tag => tag.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase())).join(', ');
    };
    const chars = toTitleCase(post.tag_string_character);
    const copy = toTitleCase(post.tag_string_copyright);
    const artist = toTitleCase(post.tag_string_artist);
    let title = chars;
    let subtitle = copy || artist || 'Original';
    if (!title) {
      if (copy) { title = copy; subtitle = artist || 'Original'; }
      else if (artist) { title = artist; subtitle = 'Original'; }
      else { title = 'Unknown Content'; subtitle = 'Original'; }
    }
    return { title, subtitle };
  };
%>
<%- include('partials/header', { tags: '' }) %>

<main id="main-content" class="container mx-auto p-4 flex flex-col md:flex-row gap-8 items-start transition-all duration-500 ease-in-out">
  
  <!-- Left Side: Related Content -->
  <div id="left-panel" class="w-full md:w-3/5 lg:w-2/3 order-2 md:order-1 flex-grow min-w-0 transition-all duration-500 ease-in-out overflow-hidden md:opacity-100">
    <% if (locals.hasRelatedTags) { %>
    <div class="mb-8" id="related-posts-section">
      <h2 class="text-2xl font-bold mb-6 text-white border-b border-gray-700 pb-2">Konten Terkait</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4" id="related-posts-grid">
        <!-- Related items di-load via API -->
      </div>
      <div id="related-loader" class="w-full flex justify-center py-6 hidden">
        <div class="w-8 h-8 border-4 border-t-cyan-500 border-gray-600 rounded-full animate-spin"></div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Right Side: Details & Image -->
  <!-- Right Side: Details & Image -->
  <div id="right-panel" class="w-full md:w-2/5 lg:w-1/3 order-1 md:order-2 shrink-0 md:sticky md:top-24 md:h-[calc(100vh-7rem)] md:overflow-y-auto hide-scrollbar pb-4 space-y-6 transition-all duration-500 ease-in-out">
    
    <div id="detail-header" class="items-center justify-between border-b border-gray-700 pb-2 hidden md:flex transition-all duration-300">
      <h2 id="detail-title" class="text-2xl font-bold text-white transition-opacity duration-300">Detail Konten</h2>
      <button id="toggle-related-btn" class="text-gray-400 hover:text-white transition-colors bg-gray-800 hover:bg-gray-700 p-1 rounded-md" title="Sembunyikan/Tampilkan Konten Terkait">
        <svg id="toggle-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
    </div>

    <div id="right-panel-inner" class="flex flex-col gap-6 w-full">
      <div id="detail-left-column" class="flex flex-col gap-6 w-full">
      <div id="detail-image-container" class="bg-gray-800 rounded-lg p-2 flex flex-col justify-center items-center">
      <div id="image-notes-wrapper" class="relative inline-block max-w-full">
      <% if (locals.notes && locals.notes.length > 0) { %>
        <button id="toggle-notes-btn" class="absolute top-2 right-2 z-30 p-2 bg-black/60 hover:bg-black/80 text-white rounded-md transition-colors shadow-md backdrop-blur-sm" title="Tampilkan Terjemahan (<%= locals.notes.length %>)">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
        </button>
      <% } %>
      <% if (post.file_ext === 'mp4' || post.file_ext === 'webm' || post.file_ext === "zip") { %>
      <video src="<%= post.large_file_url %>" class="max-w-full max-h-[90vh] rounded-md" controls autoplay loop muted></video>
      <% } else { %>
      <img id="detail-main-image" src="<%= post.large_file_url %>" alt="Detail konten" class="max-w-full max-h-[90vh] rounded-md" data-original-width="<%= post.image_width %>" data-original-height="<%= post.image_height %>">
      <% } %>
      <% if (locals.notes && locals.notes.length > 0) { %>
      <div id="notes-overlay" class="absolute inset-0 pointer-events-none hidden">
        <% locals.notes.forEach((note, i) => { %>
        <div class="note-box absolute pointer-events-auto cursor-pointer opacity-0 hover:opacity-100 transition-opacity duration-200"
          data-x="<%= note.x %>" data-y="<%= note.y %>" data-w="<%= note.width %>" data-h="<%= note.height %>"
          style="border: 1px solid rgba(255,255,0,0.6); background: rgba(255,255,0,0.08);">
          <div class="note-tooltip hidden absolute left-0 top-full z-50 mt-1 bg-gray-900/95 border border-gray-600 text-white text-xs p-2 rounded-md shadow-lg max-w-[250px] leading-relaxed whitespace-pre-wrap break-words"><%- note.body %></div>
        </div>
        <% }) %>
      </div>
      <% } %>
      </div>
      <!-- Mobile Download Progress Bar -->
      <div id="mobile-dl-container" class="w-full mt-4 hidden md:hidden px-2">
        <div class="flex justify-between text-xs text-gray-400 mb-1 font-semibold">
          <span id="mobile-dl-text">Mengunduh...</span>
          <span id="mobile-dl-percent">0%</span>
        </div>
        <div class="w-full bg-gray-700 rounded-full h-2.5 overflow-hidden">
          <div id="mobile-dl-bar" class="bg-cyan-500 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <% if (locals.artistCommentary) { %>
    <div class="bg-gray-800 rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-semibold text-pink-400 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          Artist Commentary
        </h3>
        <% if (locals.artistCommentary.translated_description && locals.artistCommentary.original_description) { %>
        <div class="flex bg-gray-700 rounded-md overflow-hidden text-[10px] font-bold border border-gray-600">
          <button id="commentary-translated-btn" class="px-2 py-1 bg-pink-700 text-white transition-colors" onclick="toggleCommentary('translated')">EN</button>
          <button id="commentary-original-btn" class="px-2 py-1 text-gray-400 hover:text-white transition-colors" onclick="toggleCommentary('original')">JP</button>
        </div>
        <% } %>
      </div>
      <div class="bg-gray-900/50 rounded-md p-3 text-sm text-gray-200 leading-relaxed border border-gray-700">
        <% if (locals.artistCommentary.translated_title || locals.artistCommentary.original_title) { %>
        <p id="commentary-title" class="font-bold mb-2 text-white"><%= locals.artistCommentary.translated_title || locals.artistCommentary.original_title %></p>
        <% } %>
        <div id="commentary-translated" class="whitespace-pre-wrap break-words"><%= locals.artistCommentary.translated_description || locals.artistCommentary.original_description %></div>
        <% if (locals.artistCommentary.original_description && locals.artistCommentary.translated_description) { %>
        <div id="commentary-original" class="whitespace-pre-wrap break-words hidden"><%= locals.artistCommentary.original_description %></div>
        <% } %>
      </div>
    </div>
    <% } %>
      </div>

    <div id="detail-info-container">
      <h2 class="text-2xl font-bold mb-4">Informasi & Tag</h2>
      <div class="space-y-4">

        <div>
          <h3 class="font-semibold mb-2 text-gray-400">Metadata</h3>
          <div class="flex flex-wrap gap-2 text-sm">
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>ID:</strong> <%= post.id %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Rating:</strong> <%= post.rating.toUpperCase() %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Score:</strong> <%= post.score %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Size:</strong> <%= (post.file_size / 1024 / 1024).toFixed(2) %> MB</span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Dimensions:</strong> <%= post.image_width %>x<%= post.image_height %></span>
            <span class="bg-gray-700 px-2 py-1 rounded-md"><strong>Uploaded:</strong> <span class="local-time" data-timestamp="<%= post.created_at %>"><%= new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span></span>
            <% if (post.source) { %>
            <a href="<%= post.source %>" target="_blank" rel="noopener noreferrer" class="bg-gray-700 hover:bg-gray-600 px-2 py-1 rounded-md flex items-center gap-1">
              <strong>Source</strong>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            </a>
            <% } %>
          </div>
        </div>

        <% if (post.parent_id || post.has_children) { %>
        <div id="parent-child-section">
          <h3 class="font-semibold mb-2 text-gray-400">Relasi Post</h3>
          <div class="flex flex-col gap-2">

            <% if (post.parent_id) { %>
            <div class="flex flex-col gap-1">
              <div class="text-xs text-[#c0a000] font-semibold uppercase tracking-wider mb-1 flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-[#c0a000]"></div>Parent Post</div>
              <% if (locals.parentPost) { %>
              <a href="/posts/<%= post.parent_id %>" class="flex items-center gap-3 bg-gray-700 hover:bg-gray-600 border border-[#c0a000]/50 rounded-md p-2 transition-colors group">
                <div class="w-12 h-12 bg-gray-800 rounded flex-shrink-0 overflow-hidden relative">
                  <% const pUrl = locals.parentPost.media_asset?.variants?.find(v => v.type === '360x360')?.url || locals.parentPost.preview_file_url || locals.parentPost.large_file_url; %>
                  <img src="<%= pUrl %>" class="w-full h-full object-cover">
                  <% if (locals.parentPost.file_ext === 'mp4' || locals.parentPost.file_ext === 'webm') { %>
                  <div class="absolute inset-0 flex items-center justify-center bg-black/30"><svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                  <% } %>
                </div>
                <div class="flex-grow min-w-0">
                  <div class="text-sm text-white font-mono truncate">#<%= post.parent_id %></div>
                  <div class="text-xs text-gray-400">Pindah ke Parent</div>
                </div>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-white flex-shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
              <% } else { %>
              <a href="/posts/<%= post.parent_id %>" class="flex items-center gap-3 bg-gray-700 hover:bg-gray-600 border border-[#c0a000]/50 rounded-md px-3 py-2 transition-colors group">
                <div class="flex-grow min-w-0">
                  <div class="text-sm text-white font-mono truncate">#<%= post.parent_id %></div>
                </div>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-white flex-shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
              <% } %>
            </div>
            <% } %>

            <% if (post.has_children && locals.childrenPosts && locals.childrenPosts.length > 0) { %>
            <div class="flex flex-col gap-2 mt-2">
              <div class="text-xs text-[#7ec832] font-semibold uppercase tracking-wider flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-[#4a8c00]"></div>Children (<%= locals.childrenPosts.length %>)</div>
              <div class="flex flex-col gap-2 max-h-[300px] overflow-y-auto hide-scrollbar pr-1">
                <% locals.childrenPosts.forEach(child => { %>
                <a href="/posts/<%= child.id %>" class="flex items-center gap-3 bg-gray-700 hover:bg-gray-600 border border-[#4a8c00]/50 rounded-md p-2 transition-colors group">
                  <div class="w-12 h-12 bg-gray-800 rounded flex-shrink-0 overflow-hidden relative">
                    <% const cUrl = child.media_asset?.variants?.find(v => v.type === '360x360')?.url || child.preview_file_url || child.large_file_url; %>
                    <img src="<%= cUrl %>" class="w-full h-full object-cover">
                    <% if (child.file_ext === 'mp4' || child.file_ext === 'webm') { %>
                    <div class="absolute inset-0 flex items-center justify-center bg-black/30"><svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                    <% } %>
                  </div>
                  <div class="flex-grow min-w-0">
                    <div class="text-sm text-white font-mono truncate">#<%= child.id %></div>
                    <div class="text-xs text-gray-400">Pindah ke Child</div>
                  </div>
                  <svg class="w-4 h-4 text-gray-400 group-hover:text-white flex-shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
                <% }) %>
              </div>
            </div>
            <% } else if (post.has_children) { %>
            <div class="flex items-center gap-3 bg-gray-700 border border-[#4a8c00]/50 rounded-md px-3 py-2 mt-2">
              <div class="w-2 h-2 rounded-full bg-[#4a8c00] flex-shrink-0"></div>
              <div class="text-xs text-[#7ec832] font-semibold uppercase tracking-wider">Has Children</div>
            </div>
            <% } %>

          </div>
        </div>
        <% } %>

        <% const renderTags = (title, tagString, colorClass, tagType, collapsible = false) => {
            if (tagString && tagString.trim() !== '') {
                  const tags = tagString.split(' ');%>
        <div class="<%= collapsible ? 'mt-4' : '' %>">
          <div class="flex justify-between items-center <%= collapsible ? 'cursor-pointer collapse-trigger' : '' %>">
            <h3 class="font-semibold mb-2 <%= colorClass %>"><%= title %> <%= collapsible ? `(${tags.length})` : '' %></h3>
            <% if (collapsible) { %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 transition-transform duration-300 transform collapse-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            <% } %>
          </div>
          <div class="flex flex-wrap gap-2 <%= collapsible ? 'hidden mt-2 collapse-content' : '' %>">
            <% tags.forEach(tag => { 
                 const isFollowed = locals.followedTags && locals.followedTags.includes(tag);
            %>
            <div class="flex items-stretch bg-gray-700 hover:bg-gray-600 rounded-md overflow-hidden border border-gray-600">
              <a href="/search?tags=<%= tag %>" class="tag-link text-sm px-2 py-1 flex items-center">
                <%= tag.replace(/_/g, ' ') %>
              </a>
              <% if (locals.user && tagType) { %>
                <button data-tag="<%= tag %>" data-type="<%= tagType %>" class="follow-btn px-2 flex items-center border-l border-gray-600 <%= isFollowed ? 'bg-cyan-600 text-white hover:bg-cyan-700' : 'text-gray-400 hover:bg-gray-500 hover:text-white' %> transition-colors" title="<%= isFollowed ? 'Unfollow' : 'Follow' %>">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 follow-icon <%= isFollowed ? 'hidden' : 'block' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 followed-icon <%= isFollowed ? 'block' : 'hidden' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>
              <% } %>
            </div>
            <% }); %>
          </div>
        </div>
        <%
            }
          }
        %>
        <% renderTags('Copyright', post.tag_string_copyright, 'text-purple-400', 3); %>
        <% renderTags('Character(s)', post.tag_string_character, 'text-green-400', 4); %>
        <% renderTags('Artist', post.tag_string_artist, 'text-red-400', 1); %>
        <% renderTags('Meta Tags', post.tag_string_meta, 'text-yellow-400', null); %>
        <% renderTags('General Tags', post.tag_string_general, 'text-blue-400', null, true); %>

        <% if (locals.poolsData && locals.poolsData.length > 0) { %>
        <div class="mt-4 pt-4 border-t border-gray-700">
          <h3 class="font-semibold mb-3 text-cyan-400 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            Pool (<%= locals.poolsData.length %>)
          </h3>
          <div class="flex flex-col gap-3">
            <% locals.poolsData.forEach(pool => { %>
            <div class="bg-gray-700 border border-gray-600 rounded-md p-3">
              <div class="flex items-center justify-between gap-2 mb-1">
                <a href="https://danbooru.donmai.us/pools/<%= pool.id %>" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-cyan-300 hover:text-cyan-200 truncate transition-colors"><%= pool.name %></a>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-600 text-gray-300 uppercase font-bold flex-shrink-0"><%= pool.category %></span>
              </div>
              <div class="text-xs text-gray-400 mb-2">
                <% if (pool.currentIndex >= 0) { %>
                Post <%= pool.currentIndex + 1 %> dari <%= pool.post_count %>
                <% } else { %>
                <%= pool.post_count %> post
                <% } %>
              </div>
              <% if (pool.prevPostId || pool.nextPostId) { %>
              <div class="flex gap-2">
                <% if (pool.prevPostId) { %>
                <a href="/posts/<%= pool.prevPostId %>" class="flex-1 text-center text-xs bg-gray-600 hover:bg-gray-500 text-white py-1.5 rounded-md transition-colors flex items-center justify-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  Sebelumnya
                </a>
                <% } %>
                <% if (pool.nextPostId) { %>
                <a href="/posts/<%= pool.nextPostId %>" class="flex-1 text-center text-xs bg-cyan-700 hover:bg-cyan-600 text-white py-1.5 rounded-md transition-colors flex items-center justify-center gap-1">
                  Selanjutnya
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
                <% } %>
              </div>
              <% } %>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <div class="pt-4 flex flex-col gap-3">
          <div class="flex gap-3">
            <% if (locals.user) { %>
              <button id="save-button" class="flex-1 <%= isSaved ? 'bg-green-600 hover:bg-green-700' : 'bg-yellow-600 hover:bg-yellow-700' %> text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Simpan Konten">
                <svg class="w-5 h-5 flex-shrink-0" fill="<%= isSaved ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <span id="save-button-text" class="truncate text-base"><%= isSaved ? 'Tersimpan' : 'Simpan' %></span>
              </button>
            <% } %>
            <button id="download-button" class="flex-1 bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Download Original">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
              <span class="truncate text-base">Download</span>
            </button>
          </div>
          <div class="flex gap-3">
            <a href="<%= post.large_file_url %>" target="_blank" rel="noopener noreferrer" class="flex-1 bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Lihat Gambar Penuh">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
              <span class="truncate text-base">Lihat Penuh</span>
            </a>
            <button id="share-button" class="flex-1 bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded-md flex items-center justify-center gap-2 transition-colors" title="Bagikan">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
              <span class="truncate text-base">Bagikan</span>
            </button>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</main>

