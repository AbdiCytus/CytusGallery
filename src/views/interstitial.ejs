<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Memuat Halaman Detail...</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-900 overflow-hidden m-0 p-0">
  <div class="fixed inset-0 flex flex-col items-center justify-center">
    <div class="w-16 h-16 border-4 border-t-cyan-500 border-gray-600 rounded-full animate-spin"></div>
    <p class="text-lg text-white mt-4 animate-pulse">Memuat Konten...</p>
  </div>
  <script>
    // Ganti URL tanpa menambah history baru, ini akan membuat browser menunggu server
    // dan tetap menampilkan animasi ini selama server bekerja mengambil data dari API
    window.location.replace('/posts/<%= postId %>?load=true');
  </script>
</body>
</html>
